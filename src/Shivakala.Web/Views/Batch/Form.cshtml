@model Shivakala.Core.Entities.Batch
@{ var isEdit = Model.Id > 0; ViewData["Title"] = (isEdit ? "Edit" : "Create") + " Batch"; }

<section class="page-hero" style="background:linear-gradient(135deg,var(--navy-dark),var(--navy-mid))">
    <div class="container">
        <span class="badge-soft">Admin</span>
        <h1>@(isEdit ? "Edit Batch" : "Create Batch")</h1>
    </div>
</section>

<section class="section-shell pt-0">
    <div class="container" style="max-width:700px">
        <div class="glass-card">
            <form asp-action="@(isEdit ? "Edit" : "Create")" asp-route-id="@Model.Id" method="post">
                @Html.AntiForgeryToken()
                <div asp-validation-summary="ModelOnly" class="alert alert-danger"></div>
                <div class="row g-3">
                    <div class="col-md-8">
                        <label class="form-label fw-600">Batch Name *</label>
                        <input asp-for="Name" class="form-control" required placeholder="e.g. 8th Morning Batch A" />
                        <span asp-validation-for="Name" class="text-danger small"></span>
                    </div>
                    <div class="col-md-4">
                        <label class="form-label fw-600">Standard *</label>
                        <select asp-for="Standard" class="form-select" required>
                            <option value="">— Select —</option>
                            @foreach (var s in new[]{"KG1","KG2","1st","2nd","3rd","4th","5th","6th","7th","8th","9th","10th"})
                            { <option value="@s">@s</option> }
                        </select>
                    </div>
                    <div class="col-md-4">
                        <label class="form-label fw-600">Medium</label>
                        <select asp-for="Medium" class="form-select">
                            <option value="">— Select —</option>
                            @foreach (var m in new[]{"English","Marathi","Semi-English","Hindi"})
                            { <option value="@m">@m</option> }
                        </select>
                    </div>
                    <div class="col-md-4">
                        <label class="form-label fw-600">Timing Slot</label>
                        <input asp-for="TimingSlot" class="form-control" placeholder="07:00 – 09:00" />
                    </div>
                    <div class="col-md-4">
                        <label class="form-label fw-600">Room / Hall</label>
                        <input asp-for="Room" class="form-control" placeholder="Room A" />
                    </div>
                    <div class="col-md-4">
                        <label class="form-label fw-600">Max Strength</label>
                        <input asp-for="MaxStrength" type="number" class="form-control" min="1" max="100" />
                    </div>
                    <div class="col-md-4">
                        <label class="form-label fw-600">Academic Year</label>
                        <input asp-for="AcademicYear" class="form-control" placeholder="2025-26" />
                    </div>
                    <div class="col-md-4">
                        <div class="form-check mt-4">
                            <input asp-for="IsActive" class="form-check-input" type="checkbox" />
                            <label asp-for="IsActive" class="form-check-label fw-600">Active</label>
                        </div>
                    </div>
                </div>
                <div class="d-flex gap-2 mt-4">
                    <button type="submit" class="btn-primary-sk">
                        <i class="fa-solid fa-floppy-disk"></i> @(isEdit ? "Update" : "Create") Batch
                    </button>
                    <a asp-action="Index" class="btn-outline-sk">Cancel</a>
                </div>
            </form>
        </div>
    </div>
</section>
