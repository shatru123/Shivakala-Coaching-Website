@model Shivakala.Core.Entities.Batch
@{ ViewData["Title"] = Model.Name + " | Batch Detail"; }

<section class="page-hero" style="background:linear-gradient(135deg,var(--navy-dark),var(--navy-mid))">
    <div class="container">
        <a asp-action="Index" class="badge-soft mb-2 d-inline-block">← Batches</a>
        <h1>@Model.Name</h1>
        <p>@Model.Standard · @Model.Medium · @Model.TimingSlot · @Model.AcademicYear</p>
    </div>
</section>

<section class="section-shell pt-0">
    <div class="container">
        <div class="row g-4">
            <!-- Enrolled Students -->
            <div class="col-lg-7">
                <div class="glass-card">
                    <div class="d-flex justify-content-between align-items-center mb-3">
                        <h5 class="mb-0">Enrolled Students (@Model.StudentBatches.Count(sb=>sb.IsActive) / @Model.MaxStrength)</h5>
                    </div>

                    <!-- Assign Student -->
                    <form asp-action="AssignStudent" asp-route-id="@Model.Id" method="post" class="d-flex gap-2 mb-3">
                        @Html.AntiForgeryToken()
                        <select name="studentId" class="form-select">
                            <option value="">— Add Student —</option>
                            @foreach (var s in (IReadOnlyList<Shivakala.Core.Entities.Student>)ViewBag.AllStudents)
                            {
                                if (Model.StudentBatches.All(sb => sb.StudentId != s.Id))
                                { <option value="@s.Id">@s.FullName (@s.Standard)</option> }
                            }
                        </select>
                        <button type="submit" class="btn-primary-sk" style="white-space:nowrap"><i class="fa-solid fa-plus"></i>Add</button>
                    </form>

                    <div class="table-responsive">
                        <table class="table table-sm admin-table">
                            <thead><tr><th>Student</th><th>Joined</th><th></th></tr></thead>
                            <tbody>
                                @foreach (var sb in Model.StudentBatches.Where(x=>x.IsActive))
                                {
                                    <tr>
                                        <td style="font-weight:600">@sb.Student?.FullName</td>
                                        <td style="font-size:.8rem">@sb.JoinDate.ToLocalTime().ToString("dd MMM yy")</td>
                                        <td>
                                            <form asp-action="RemoveStudent" asp-route-id="@Model.Id" method="post">
                                                @Html.AntiForgeryToken()
                                                <input type="hidden" name="studentBatchId" value="@sb.Id" />
                                                <button class="toolbar-btn" style="font-size:.68rem;padding:3px 8px;background:var(--red)">
                                                    <i class="fa-solid fa-user-minus"></i>
                                                </button>
                                            </form>
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>

            <!-- Subjects -->
            <div class="col-lg-5">
                <div class="glass-card mb-4">
                    <h5 class="mb-3">Subjects</h5>
                    @foreach (var bs in Model.BatchSubjects)
                    {
                        <div class="d-flex justify-content-between align-items-center py-2"
                             style="border-bottom:1px solid var(--border)">
                            <span style="font-weight:600">@bs.Subject</span>
                            <small class="text-muted">@(bs.Teacher?.FullName ?? "Unassigned")</small>
                        </div>
                    }
                    @if (!Model.BatchSubjects.Any())
                    { <p class="text-muted small">No subjects added yet.</p> }
                </div>

                <!-- Quick links -->
                <div class="glass-card">
                    <h5 class="mb-3">Quick Actions</h5>
                    <div class="d-grid gap-2">
                        <a asp-controller="Attendance" asp-action="Mark" asp-route-batchId="@Model.Id"
                           asp-route-date="@UtcDateTime.Today().ToString("yyyy-MM-dd")" class="btn-primary-sk text-center">
                            <i class="fa-solid fa-list-check"></i> Mark Today's Attendance
                        </a>
                        <a asp-controller="Timetable" asp-action="Index" asp-route-batchId="@Model.Id"
                           class="btn-outline-sk text-center">
                            <i class="fa-solid fa-calendar-week"></i> View Timetable
                        </a>
                        <a asp-controller="Attendance" asp-action="Report" asp-route-batchId="@Model.Id"
                           class="btn-outline-sk text-center">
                            <i class="fa-solid fa-chart-pie"></i> Attendance Report
                        </a>
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>
