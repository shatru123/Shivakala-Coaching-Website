@model EnquiryFormViewModel
@{
    ViewData["Title"] = T["EnquiryTitle"];
    ViewData["MetaDescription"] = T["EnquiryLead"];
}

<section class="page-hero">
    <div class="container">
        <span class="badge-soft">@T["NavEnquiry"]</span>
        <h1>@T["EnquiryTitle"]</h1>
        <p>@T["EnquiryLead"]</p>
    </div>
</section>

<section class="section-shell">
    <div class="container">
        <div class="row justify-content-center">
            <div class="col-lg-8">
                <div class="glass-card reveal">
                    <form asp-action="Index" method="post" novalidate>
                        @Html.AntiForgeryToken()
                        <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>
                        <div class="row g-4">
                            <div class="col-md-6">
                                <label asp-for="Name" class="form-label">@T["FullName"]</label>
                                <input asp-for="Name" class="form-control" />
                                <span asp-validation-for="Name" class="text-danger small"></span>
                            </div>
                            <div class="col-md-6">
                                <label asp-for="Mobile" class="form-label">@T["MobileNumber"]</label>
                                <input asp-for="Mobile" class="form-control" />
                                <span asp-validation-for="Mobile" class="text-danger small"></span>
                            </div>
                            <div class="col-12">
                                <label asp-for="Message" class="form-label">@T["Message"]</label>
                                <textarea asp-for="Message" class="form-control" rows="6"></textarea>
                                <span asp-validation-for="Message" class="text-danger small"></span>
                            </div>
                            <div class="col-12">
                                <button type="submit" class="btn btn-gradient btn-lg">@T["SubmitEnquiry"]</button>
                            </div>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</section>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
