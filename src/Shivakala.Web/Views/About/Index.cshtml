@model Shivakala.Core.ViewModels.AboutPageViewModel
@using System.Globalization
@{
    ViewData["Title"] = Model?.Seo?.Title ?? "About Us | Shivakala Coaching Classes";
    ViewData["MetaDescription"] = Model?.Seo?.Description ?? "Learn about Shivakala Coaching Classes - KG1 to 10th, Chikhali.";
    var isMr = CultureInfo.CurrentUICulture.TwoLetterISOLanguageName == "mr";
}

<section class="page-hero">
    <div class="container">
        <span class="badge-soft"><i class="fa-solid fa-school me-1"></i>@(isMr ? "आमच्याबद्दल" : "About Us")</span>
        <h1>@(isMr ? "शिवकला क्लासेस" : "Shivakala Coaching Classes")</h1>
        <p>@(isMr ? "चिखली, महाराष्ट्र — SK लर्निंग फॉर लाइफ" : "Chikhali, Maharashtra — SK Learning For Life")</p>
    </div>
</section>

<section class="section-shell warm-section">
    <div class="container">
        <div class="row g-4 align-items-center">
            <div class="col-lg-6">
                <div class="eyebrow mb-2"><i class="fa-solid fa-star me-1"></i>@(isMr ? "आमची ओळख" : "Our Story")</div>
                <h2 style="color:var(--navy)">@(isMr ? "भक्कम पाया आज, उज्ज्वल यश उद्या!" : "Strong Foundation Today, Brilliant Success Tomorrow!")</h2>
                <p class="text-muted mt-3">@(isMr ? "शिवकला क्लासेसची स्थापना विद्यार्थ्यांना उत्कृष्ट शिक्षण देण्याच्या उद्देशाने झाली. आम्ही KG1 ते 10वी पर्यंत गणित, इंग्रजी आणि विज्ञान या विषयांत मार्गदर्शन करतो." : "Shivakala Coaching Classes was founded with a mission to provide exceptional academic guidance. We offer coaching for KG1 to 10th Standard in Mathematics, English and Science.")</p>
                <p class="text-muted">@(isMr ? "आमचे अनुभवी शिक्षक प्रत्येक विद्यार्थ्याकडे वैयक्तिक लक्ष देतात व त्यांना त्यांच्या क्षमतेपर्यंत पोहोचण्यास मदत करतात." : "Our experienced faculty gives personal attention to every student, helping them realize their full potential through concept-based learning.")</p>
            </div>
            <div class="col-lg-6">
                @if (Model is { ShowStatisticsSection: true } && Model.Statistics.Count > 0)
                {
                    <div class="row g-3">
                        @foreach (var statistic in Model.Statistics.Take(4))
                        {
                            <div class="col-6">
                                <div class="stat-card">
                                    <strong>@statistic.Value</strong>
                                    <span>@statistic.Label</span>
                                </div>
                            </div>
                        }
                    </div>
                }
            </div>
        </div>
    </div>
</section>

@if (Model?.FacultyMembers is { Count: > 0 })
{
    <section class="section-shell" style="background:var(--white)">
        <div class="container">
            <div class="section-header text-center mb-4">
                <div class="eyebrow"><i class="fa-solid fa-chalkboard-user me-1"></i>@(isMr ? "आमचे शिक्षक" : "Our Faculty")</div>
                <h2>@(isMr ? "अनुभवी व तज्ज्ञ शिक्षकवर्ग" : "Meet Our Expert Faculty")</h2>
            </div>
            <div class="row g-3">
                @foreach (var f in Model.FacultyMembers)
                {
                    <div class="col-lg-3 col-md-6">
                        @await Html.PartialAsync("Partials/_FacultyCard", f)
                    </div>
                }
            </div>
        </div>
    </section>
}

<section class="section-shell warm-section">
    <div class="container">
        <div class="section-header text-center mb-4">
            <div class="eyebrow"><i class="fa-solid fa-star me-1"></i>@(isMr ? "आमची वैशिष्ट्ये" : "Our Features")</div>
            <h2>@(isMr ? "आम्हालाच का निवडावे?" : "Why Shivakala?")</h2>
        </div>
        <div class="row g-3">
            @{
                var features = isMr
                    ? new[] {("fa-clipboard-list","नियमित चाचण्या","दर शनिवारी साप्ताहिक चाचणी व दर रविवारी निकाल."),("fa-lightbulb","संकल्पना आधारित शिक्षण","कठीण संकल्पना सोप्या भाषेत शिकवल्या जातात."),("fa-user-check","वैयक्तिक लक्ष","प्रत्येक विद्यार्थ्याला स्वतंत्र मार्गदर्शन मिळते."),("fa-chart-line","उत्तम निकाल","आमचे विद्यार्थी नेहमी उत्कृष्ट यश मिळवतात.")}
                    : new[] {("fa-clipboard-list","Regular Tests","Weekly tests every Saturday with results on Sunday."),("fa-lightbulb","Concept Learning","Difficult concepts explained in simple, engaging ways."),("fa-user-check","Personal Attention","Individual guidance catered to each student's pace."),("fa-chart-line","Better Results","Our students consistently achieve top grades.")};
            }
            @foreach (var (icon, title, desc) in features)
            {
                <div class="col-lg-3 col-md-6">
                    <div class="feature-card reveal">
                        <div class="icon-wrap"><i class="fa-solid @icon"></i></div>
                        <h3>@title</h3>
                        <p>@desc</p>
                    </div>
                </div>
            }
        </div>
    </div>
</section>

@if (Model is not null && (!string.IsNullOrWhiteSpace(Model.Address) || !string.IsNullOrWhiteSpace(Model.MapEmbedUrl)))
{
    <section class="section-shell" style="background:var(--white)">
        <div class="container">
            <div class="section-header text-center mb-4">
                <div class="eyebrow"><i class="fa-solid fa-map-location-dot me-1"></i>@(isMr ? "ठिकाण" : "Location")</div>
                <h2>@(isMr ? "आम्हाला भेट द्या" : "Visit Our Campus")</h2>
            </div>
            <div class="row g-4 align-items-stretch">
                <div class="col-lg-5">
                    <div class="feature-card h-100">
                        <div class="icon-wrap"><i class="fa-solid fa-location-dot"></i></div>
                        <h3>@(isMr ? "पत्ता" : "Address")</h3>
                        <p>@Model.Address</p>
                    </div>
                </div>
                <div class="col-lg-7">
                    @if (!string.IsNullOrWhiteSpace(Model.MapEmbedUrl))
                    {
                        <div class="map-frame" style="height:100%">
                            <iframe
                                src="@Model.MapEmbedUrl"
                                width="100%"
                                height="320"
                                style="border:0;border-radius:24px"
                                loading="lazy"
                                allowfullscreen=""
                                referrerpolicy="no-referrer-when-downgrade">
                            </iframe>
                        </div>
                    }
                </div>
            </div>
        </div>
    </section>
}
