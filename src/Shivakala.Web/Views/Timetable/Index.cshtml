@{ ViewData["Title"] = "Timetable | Admin"; var days = (string[])ViewBag.Days; }

<section class="page-hero" style="background:linear-gradient(135deg,var(--navy-dark),var(--navy-mid))">
    <div class="container d-flex justify-content-between align-items-center flex-wrap gap-3">
        <div><span class="badge-soft"><i class="fa-solid fa-calendar-week me-1"></i>Admin</span><h1>Timetable</h1></div>
        @if (ViewBag.SelectedBatchId != null)
        {
            <a asp-action="Create" asp-route-batchId="@ViewBag.SelectedBatchId" class="btn-primary-sk">
                <i class="fa-solid fa-plus"></i>Add Slot
            </a>
        }
    </div>
</section>

<section class="section-shell pt-0">
    <div class="container">
        <!-- Batch picker -->
        <form method="get" class="glass-card mb-4 d-flex gap-2 align-items-end">
            <div style="flex:1">
                <label class="form-label fw-600">Select Batch</label>
                <select name="batchId" class="form-select" onchange="this.form.submit()">
                    <option value="">— Select Batch —</option>
                    @foreach (var b in (IReadOnlyList<Shivakala.Core.Entities.Batch>)ViewBag.Batches)
                    { <option value="@b.Id" selected="@(ViewBag.SelectedBatchId?.ToString()==b.Id.ToString())">@b.Name (@b.Standard)</option> }
                </select>
            </div>
            <button class="btn-primary-sk">View</button>
        </form>

        @if (ViewBag.Slots is List<Shivakala.Core.Entities.TimetableSlot> slots)
        {
            <!-- Weekly grid -->
            <div class="glass-card">
                <div class="table-responsive">
                    <table class="table admin-table" style="min-width:700px">
                        <thead>
                            <tr>
                                <th style="width:80px">Time</th>
                                @for (int d = 1; d <= 7; d++)
                                { <th>@days[d-1]</th> }
                            </tr>
                        </thead>
                        <tbody>
                            @{
                                var groups = slots.GroupBy(s => s.StartTime).OrderBy(g => g.Key);
                            }
                            @foreach (var grp in groups)
                            {
                                <tr>
                                    <td style="font-size:.78rem;white-space:nowrap;font-weight:600">
                                        @grp.Key.ToString("HH:mm")–@grp.First().EndTime.ToString("HH:mm")
                                    </td>
                                    @for (int d = 1; d <= 7; d++)
                                    {
                                        var slot = grp.FirstOrDefault(s => s.DayOfWeek == d);
                                        if (slot != null)
                                        {
                                            <td style="background:rgba(26,58,107,.08);border-radius:8px">
                                                <div style="font-weight:700;font-size:.82rem">@slot.Subject</div>
                                                <div style="font-size:.72rem;color:var(--gold-dark)">@slot.Teacher?.FullName</div>
                                                <div style="font-size:.68rem;color:#888">@(slot.Room ?? "")</div>
                                                <form asp-action="Delete" asp-route-id="@slot.Id" asp-route-batchId="@ViewBag.SelectedBatchId" method="post" class="d-inline">
                                                    @Html.AntiForgeryToken()
                                                    <button class="toolbar-btn mt-1" style="font-size:.6rem;padding:2px 6px;background:var(--red)">✕</button>
                                                </form>
                                            </td>
                                        }
                                        else { <td style="color:#ccc;font-size:.7rem;text-align:center">—</td> }
                                    }
                                </tr>
                            }
                            @if (!groups.Any())
                            {
                                <tr><td colspan="8" class="text-center text-muted py-4">No slots added yet. Click "Add Slot" to begin.</td></tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        }
    </div>
</section>
