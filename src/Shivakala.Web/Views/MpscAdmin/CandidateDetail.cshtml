@model Shivakala.Core.ViewModels.MpscCandidateDetailViewModel
@{
    Layout = "_AdminLayout";
    var c = Model.Candidate;
    ViewData["Title"] = $"Candidate Details - {c.RegistrationNumber}";
}

<div class="p-4">
    <div class="d-flex justify-content-between align-items-center mb-4 flex-wrap gap-3">
        <div>
            <span class="badge-soft dark mb-1"><i class="fa-solid fa-user-graduate me-1"></i>Candidate Profile</span>
            <h2 class="fw-bold mb-1" style="color:var(--navy-dark)">@c.FullName</h2>
            <p class="text-muted mb-0 small">Registration No: <strong class="font-monospace text-primary">@c.RegistrationNumber</strong></p>
        </div>
        <div class="d-flex gap-2 flex-wrap">
            <a asp-action="Candidates" class="btn-outline-sk">
                <i class="fa-solid fa-arrow-left me-1"></i>Back to Directory
            </a>

            <!-- Toggle Active Status Form -->
            <form asp-action="ToggleStatus" asp-route-id="@c.Id" method="post" class="d-inline">
                @Html.AntiForgeryToken()
                <button type="submit" class="btn @(c.IsActive ? "btn-outline-danger" : "btn-outline-success") btn-sm" onclick="return confirm('Are you sure you want to @(c.IsActive ? "deactivate" : "activate") this candidate?');">
                    <i class="fa-solid @(c.IsActive ? "fa-user-slash" : "fa-user-check") me-1"></i>
                    @(c.IsActive ? "Deactivate Account" : "Activate Account")
                </button>
            </form>

            <!-- Reset Password Button triggers modal -->
            <button type="button" class="btn btn-warning btn-sm text-dark" data-bs-toggle="modal" data-bs-target="#modalResetPassword">
                <i class="fa-solid fa-key me-1"></i>Reset Password
            </button>
        </div>
    </div>

    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show mb-4 shadow-sm" role="alert">
            <i class="fa-solid fa-circle-check me-2"></i>@TempData["SuccessMessage"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }
    @if (TempData["ErrorMessage"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show mb-4 shadow-sm" role="alert">
            <i class="fa-solid fa-triangle-exclamation me-2"></i>@TempData["ErrorMessage"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }

    <!-- PROFILE DETAILS CARDS -->
    <div class="row g-4 mb-4">
        <!-- Profile summary card -->
        <div class="col-lg-4">
            <div class="glass-card p-4 h-100 text-center">
                <div class="rounded-circle overflow-hidden bg-light d-inline-flex align-items-center justify-content-center border shadow-sm mb-3" style="width:110px;height:110px;">
                    @if (!string.IsNullOrWhiteSpace(c.PhotoUrl))
                    {
                        <img src="@c.PhotoUrl" alt="@c.FullName" style="width:100%;height:100%;object-fit:cover;" />
                    }
                    else
                    {
                        <i class="fa-solid fa-user fa-3x text-secondary"></i>
                    }
                </div>
                <h5 class="fw-bold mb-1" style="color:var(--navy-dark)">@c.FullName</h5>
                @if (!string.IsNullOrWhiteSpace(c.FullNameMarathi))
                {
                    <div class="text-muted small mb-2">@c.FullNameMarathi</div>
                }
                <div class="mb-3">
                    <span class="badge @(c.IsActive ? "bg-success" : "bg-secondary")">
                        @(c.IsActive ? "Active Candidate" : "Inactive")
                    </span>
                    <span class="badge bg-primary-subtle text-primary ms-1">@c.PreferredExam</span>
                </div>

                <div class="text-start border-top pt-3 small">
                    <div class="mb-2"><strong>Mobile:</strong> <a href="tel:@c.Mobile" class="text-decoration-none text-dark">+91 @c.Mobile</a></div>
                    @if (!string.IsNullOrWhiteSpace(c.AlternateMobile))
                    {
                        <div class="mb-2"><strong>Alternate:</strong> +91 @c.AlternateMobile</div>
                    }
                    <div class="mb-2"><strong>Email:</strong> <a href="mailto:@c.Email" class="text-decoration-none">@c.Email</a></div>
                    <div class="mb-2"><strong>Date of Birth:</strong> @c.DateOfBirth (@c.Gender)</div>
                    <div class="mb-2"><strong>District:</strong> @c.District (@c.State)</div>
                    <div class="mb-2"><strong>Address:</strong> @c.Address</div>
                    <div class="mb-2"><strong>Registered On:</strong> @c.RegistrationDate.ToString("dd MMM yyyy HH:mm")</div>
                    @if (Model.UserAccount?.LastLoginDate != null)
                    {
                        <div><strong>Last Login:</strong> @Model.UserAccount.LastLoginDate.Value.ToLocalTime().ToString("dd MMM yyyy HH:mm")</div>
                    }
                </div>
            </div>
        </div>

        <!-- Educational & Exam Target Card -->
        <div class="col-lg-8">
            <div class="glass-card p-4 h-100">
                <h5 class="fw-bold mb-3 pb-2 border-bottom text-primary">
                    <i class="fa-solid fa-graduation-cap me-2"></i>Academic &amp; Examination Profile
                </h5>

                <div class="row g-3 mb-4">
                    <div class="col-sm-6 col-md-4">
                        <small class="text-muted d-block">Highest Qualification</small>
                        <span class="fw-semibold">@c.HighestQualification</span>
                    </div>
                    <div class="col-sm-6 col-md-4">
                        <small class="text-muted d-block">Degree / Course</small>
                        <span class="fw-semibold">@(string.IsNullOrWhiteSpace(c.DegreeOrCourse) ? "Not Specified" : c.DegreeOrCourse)</span>
                    </div>
                    <div class="col-sm-6 col-md-4">
                        <small class="text-muted d-block">University / Board</small>
                        <span class="fw-semibold">@(string.IsNullOrWhiteSpace(c.University) ? "Not Specified" : c.University)</span>
                    </div>
                    <div class="col-sm-6 col-md-4">
                        <small class="text-muted d-block">Year of Passing</small>
                        <span class="fw-semibold">@(c.YearOfPassing?.ToString() ?? "N/A")</span>
                    </div>
                    <div class="col-sm-6 col-md-4">
                        <small class="text-muted d-block">Preparation Level</small>
                        <span class="fw-semibold">@c.PreparationLevel</span>
                    </div>
                    <div class="col-sm-6 col-md-4">
                        <small class="text-muted d-block">Target Year</small>
                        <span class="fw-semibold">@(c.TargetAttemptYear?.ToString() ?? "N/A")</span>
                    </div>
                </div>

                <h5 class="fw-bold mb-3 pb-2 border-bottom text-primary">
                    <i class="fa-solid fa-users me-2"></i>Social Category &amp; Certificates
                </h5>

                <div class="row g-3">
                    <div class="col-sm-6 col-md-3">
                        <small class="text-muted d-block">Category</small>
                        <span class="badge bg-light text-dark border px-2.5 py-1.5 fs-6">@c.Category</span>
                    </div>
                    <div class="col-sm-6 col-md-3">
                        <small class="text-muted d-block">Caste Certificate</small>
                        <span class="badge @(c.CasteCertificateAvailable ? "bg-success" : "bg-secondary")">
                            @(c.CasteCertificateAvailable ? "Available" : "No")
                        </span>
                    </div>
                    <div class="col-sm-6 col-md-3">
                        <small class="text-muted d-block">Non-Creamy Layer (NCL)</small>
                        <span class="badge @(c.NonCreamyLayerCertificateAvailable ? "bg-success" : "bg-secondary")">
                            @(c.NonCreamyLayerCertificateAvailable ? "Available" : "No")
                        </span>
                    </div>
                    <div class="col-sm-6 col-md-3">
                        <small class="text-muted d-block">EWS Certificate</small>
                        <span class="badge @(c.EwsCertificateAvailable ? "bg-success" : "bg-secondary")">
                            @(c.EwsCertificateAvailable ? "Available" : "No")
                        </span>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- EXAM REGISTRATIONS & ATTEMPTS -->
    <div class="glass-card p-4 mb-4">
        <h5 class="fw-bold mb-3 pb-2 border-bottom" style="color:var(--navy-dark)">
            <i class="fa-solid fa-calendar-check me-2 text-primary"></i>Exam Registrations &amp; Attendance (@Model.Registrations.Count)
        </h5>

        @if (!Model.Registrations.Any())
        {
            <p class="text-muted small mb-0">No exam registrations recorded for this candidate.</p>
        }
        else
        {
            <div class="table-responsive">
                <table class="table table-hover align-middle mb-0 small">
                    <thead class="table-light">
                        <tr>
                            <th>Exam Title</th>
                            <th>Mode</th>
                            <th>Exam Date</th>
                            <th>Registered On</th>
                            <th>Seat Number</th>
                            <th>Attendance</th>
                            <th>Remarks</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var reg in Model.Registrations)
                        {
                            <tr>
                                <td><strong>@reg.Exam?.Title</strong></td>
                                <td><span class="badge @(reg.Mode == "Online" ? "bg-primary-subtle text-primary" : "bg-success-subtle text-success")">@reg.Mode</span></td>
                                <td>@reg.Exam?.ExamDate.ToString("dd MMM yyyy")</td>
                                <td>@reg.RegisteredAt.ToString("dd MMM yyyy")</td>
                                <td><span class="font-monospace">@(reg.SeatNumber ?? "-")</span></td>
                                <td>
                                    <span class="badge @(reg.AttendanceStatus == "Present" ? "bg-success" : reg.AttendanceStatus == "Absent" ? "bg-danger" : "bg-warning text-dark")">
                                        @reg.AttendanceStatus
                                    </span>
                                </td>
                                <td>@(reg.AttendanceRemarks ?? "-")</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
    </div>

    <!-- ONLINE ATTEMPTS & RESULTS -->
    <div class="glass-card p-4">
        <h5 class="fw-bold mb-3 pb-2 border-bottom" style="color:var(--navy-dark)">
            <i class="fa-solid fa-square-poll-vertical me-2 text-success"></i>Examination Results &amp; Online Attempts (@Model.Results.Count)
        </h5>

        @if (!Model.Results.Any())
        {
            <p class="text-muted small mb-0">No exam results recorded for this candidate yet.</p>
        }
        else
        {
            <div class="table-responsive">
                <table class="table table-hover align-middle mb-0 small">
                    <thead class="table-light">
                        <tr>
                            <th>Exam Title</th>
                            <th>Mode</th>
                            <th>Score</th>
                            <th>Total Marks</th>
                            <th>Grade</th>
                            <th>Rank</th>
                            <th>Status</th>
                            <th>Remarks</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var res in Model.Results)
                        {
                            <tr>
                                <td><strong>@res.Exam?.Title</strong></td>
                                <td><span class="badge @(res.Mode == "Online" ? "bg-primary-subtle text-primary" : "bg-success-subtle text-success")">@res.Mode</span></td>
                                <td><strong>@(res.MarksObtained?.ToString("F1") ?? "-")</strong></td>
                                <td>@(res.Exam?.TotalMarks ?? 100)</td>
                                <td><span class="badge bg-light text-dark border">@(res.Grade ?? "-")</span></td>
                                <td>
                                    @if (res.Rank.HasValue)
                                    {
                                        <span class="badge bg-warning text-dark">#@res.Rank</span>
                                    }
                                    else
                                    {
                                        <span>-</span>
                                    }
                                </td>
                                <td>
                                    @if (res.IsAbsent)
                                    {
                                        <span class="badge bg-secondary">Absent</span>
                                    }
                                    else if ((res.MarksObtained ?? 0) >= (res.Exam?.PassingMarks ?? 35))
                                    {
                                        <span class="badge bg-success">Passed</span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-danger">Failed</span>
                                    }
                                </td>
                                <td>@(res.Remarks ?? "-")</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
    </div>
</div>

<!-- RESET PASSWORD MODAL -->
<div class="modal fade" id="modalResetPassword" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog">
        <div class="modal-content">
            <form asp-action="ResetPassword" asp-route-id="@c.Id" method="post">
                @Html.AntiForgeryToken()
                <div class="modal-header">
                    <h5 class="modal-title fw-bold"><i class="fa-solid fa-key text-warning me-2"></i>Reset Candidate Password</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>
                <div class="modal-body">
                    <p class="small text-muted mb-3">
                        Set a new password for candidate <strong>@c.FullName</strong> (@c.RegistrationNumber).
                    </p>
                    <div class="mb-3">
                        <label class="form-label fw-semibold">New Password <span class="text-danger">*</span></label>
                        <input name="newPassword" type="password" class="form-control" placeholder="Minimum 6 characters" required minlength="6" />
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary btn-sm" data-bs-dismiss="modal">Cancel</button>
                    <button type="submit" class="btn btn-warning btn-sm text-dark fw-semibold">Update Password</button>
                </div>
            </form>
        </div>
    </div>
</div>
