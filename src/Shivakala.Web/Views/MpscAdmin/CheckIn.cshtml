@model Shivakala.Core.ViewModels.OfflineCheckInViewModel
@{
    Layout = "_AdminLayout";
    ViewData["Title"] = $"Check-In: {Model.ExamTitle}";
}

<div class="p-4">
    <div class="d-flex justify-content-between align-items-center mb-4 flex-wrap gap-3">
        <div>
            <span class="badge-soft dark mb-1"><i class="fa-solid fa-clipboard-check me-1"></i>Exam Center Check-In</span>
            <h2 class="fw-bold mb-1" style="color:var(--navy-dark)">@Model.ExamTitle</h2>
            <p class="text-muted mb-0 small">
                Venue: <strong>@(Model.Venue ?? "Main Hall")</strong> | Date: <strong>@Model.ExamDate.ToString("dd MMM yyyy")</strong>
            </p>
        </div>
        <div class="d-flex gap-2">
            <a asp-action="OfflineExams" class="btn-outline-sk">
                <i class="fa-solid fa-arrow-left me-1"></i>Back to Exams
            </a>
            <a asp-action="EnterMarks" asp-route-id="@Model.ExamId" class="btn-primary-sk">
                <i class="fa-solid fa-pen-to-square me-1"></i>Enter Marks
            </a>
        </div>
    </div>

    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show mb-4 shadow-sm" role="alert">
            <i class="fa-solid fa-circle-check me-2"></i>@TempData["SuccessMessage"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }

    <!-- STAT COUNTERS -->
    <div class="row g-3 mb-4">
        <div class="col-sm-4">
            <div class="glass-card p-3 border-start border-4 border-primary d-flex align-items-center">
                <div class="bg-primary-subtle text-primary rounded-circle p-3 me-3" style="width:48px;height:48px;display:flex;align-items:center;justify-content:center;">
                    <i class="fa-solid fa-users"></i>
                </div>
                <div>
                    <div class="fs-4 fw-bold">@Model.RegisteredCount</div>
                    <div class="text-muted small">Registered Candidates</div>
                </div>
            </div>
        </div>
        <div class="col-sm-4">
            <div class="glass-card p-3 border-start border-4 border-success d-flex align-items-center">
                <div class="bg-success-subtle text-success rounded-circle p-3 me-3" style="width:48px;height:48px;display:flex;align-items:center;justify-content:center;">
                    <i class="fa-solid fa-user-check"></i>
                </div>
                <div>
                    <div class="fs-4 fw-bold text-success">@Model.PresentCount</div>
                    <div class="text-muted small">Checked-In (Present)</div>
                </div>
            </div>
        </div>
        <div class="col-sm-4">
            <div class="glass-card p-3 border-start border-4 border-danger d-flex align-items-center">
                <div class="bg-danger-subtle text-danger rounded-circle p-3 me-3" style="width:48px;height:48px;display:flex;align-items:center;justify-content:center;">
                    <i class="fa-solid fa-user-xmark"></i>
                </div>
                <div>
                    <div class="fs-4 fw-bold text-danger">@Model.AbsentCount</div>
                    <div class="text-muted small">Absent Candidates</div>
                </div>
            </div>
        </div>
    </div>

    <!-- SEARCH FILTER -->
    <div class="glass-card p-3 mb-4">
        <form method="get" asp-action="CheckIn" asp-route-id="@Model.ExamId" class="row g-2 align-items-center">
            <div class="col-md-6">
                <div class="input-group">
                    <span class="input-group-text"><i class="fa-solid fa-magnifying-glass"></i></span>
                    <input name="search" value="@Model.SearchTerm" class="form-control form-control-sm" placeholder="Search seat number, candidate name, registration no, mobile..." />
                </div>
            </div>
            <div class="col-md-2">
                <button type="submit" class="btn btn-primary btn-sm w-100">Search</button>
            </div>
            @if (!string.IsNullOrWhiteSpace(Model.SearchTerm))
            {
                <div class="col-md-2">
                    <a asp-action="CheckIn" asp-route-id="@Model.ExamId" class="btn btn-outline-secondary btn-sm">Clear</a>
                </div>
            }
        </form>
    </div>

    <!-- PARTICIPANTS ATTENDANCE LIST -->
    <div class="glass-card p-4">
        @if (!Model.Participants.Any())
        {
            <div class="text-center py-5 text-muted">
                <i class="fa-solid fa-clipboard-user fa-3x mb-2 text-muted"></i>
                <p class="mb-0">No registered candidates found for this exam.</p>
            </div>
        }
        else
        {
            <div class="table-responsive">
                <table class="table table-hover align-middle mb-0">
                    <thead class="table-light">
                        <tr>
                            <th>Seat No</th>
                            <th>Reg No</th>
                            <th>Candidate Name</th>
                            <th>Mobile</th>
                            <th>Status</th>
                            <th>Updated</th>
                            <th class="text-end">Mark Attendance</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var p in Model.Participants)
                        {
                            <tr class="@(p.AttendanceStatus == "Present" ? "table-success" : p.AttendanceStatus == "Absent" ? "table-danger-subtle" : "")">
                                <td>
                                    <span class="badge bg-dark font-monospace fs-6">@(p.SeatNumber ?? "-")</span>
                                </td>
                                <td>
                                    <span class="badge bg-light text-primary font-monospace border">@p.RegistrationNumber</span>
                                </td>
                                <td>
                                    <strong>@p.FullName</strong>
                                    @if (!string.IsNullOrWhiteSpace(p.Remarks))
                                    {
                                        <div class="small text-muted fst-italic">@p.Remarks</div>
                                    }
                                </td>
                                <td>
                                    <small>+91 @p.Mobile</small>
                                </td>
                                <td>
                                    <span class="badge @(p.AttendanceStatus == "Present" ? "bg-success" : p.AttendanceStatus == "Absent" ? "bg-danger" : "bg-warning text-dark")">
                                        @p.AttendanceStatus
                                    </span>
                                </td>
                                <td>
                                    <small class="text-muted">@(p.AttendanceMarkedAt?.ToLocalTime().ToString("HH:mm") ?? "-")</small>
                                </td>
                                <td class="text-end">
                                    <form asp-action="UpdateAttendance" asp-route-id="@Model.ExamId" method="post" class="d-inline">
                                        @Html.AntiForgeryToken()
                                        <input type="hidden" name="registrationId" value="@p.RegistrationId" />
                                        <input type="hidden" name="seatNumber" value="@p.SeatNumber" />

                                        <button type="submit" name="status" value="Present" class="btn btn-sm btn-success me-1" title="Mark Present">
                                            <i class="fa-solid fa-check"></i> Present
                                        </button>
                                        <button type="submit" name="status" value="Absent" class="btn btn-sm btn-outline-danger me-1" title="Mark Absent">
                                            <i class="fa-solid fa-xmark"></i> Absent
                                        </button>
                                    </form>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
    </div>
</div>
