@model IReadOnlyList<Shivakala.Core.Entities.Teacher>
@{ ViewData["Title"] = "Teachers | Admin";
   var portalUsers = ViewBag.PortalUsernames as Dictionary<int, string> ?? new(); }

<section class="page-hero" style="background:linear-gradient(135deg,var(--navy-dark),var(--navy-mid))">
    <div class="container d-flex justify-content-between align-items-center flex-wrap gap-3">
        <div>
            <span class="badge-soft"><i class="fa-solid fa-chalkboard-teacher me-1"></i>Admin</span>
            <h1>Teachers</h1><p>Manage all teaching staff</p>
        </div>
        <a asp-action="Create" class="btn-primary-sk"><i class="fa-solid fa-plus"></i>Add Teacher</a>
    </div>
</section>

<section class="section-shell pt-0">
    <div class="container">
        @if (TempData["SuccessMessage"] is string msg)
        { <div class="alert alert-success">@msg</div> }
        @if (TempData["WarningMessage"] is string warning)
        { <div class="alert alert-warning">@warning</div> }
        @if (ViewBag.SchemaWarning is string schemaWarning)
        { <div class="alert alert-warning">@schemaWarning</div> }

        <div class="glass-card">
            <div class="table-responsive">
                <table class="table admin-table align-middle">
                    <thead>
                        <tr><th>Photo</th><th>Name</th><th>Mobile</th><th>Portal Login</th><th>Qualification</th><th>Subjects</th><th>About Page</th><th>Status</th><th>Actions</th></tr>
                    </thead>
                    <tbody>
                        @foreach (var t in Model)
                        {
                            <tr>
                                <td>
                                    @if (!string.IsNullOrEmpty(t.PhotoUrl))
                                    { <img src="@t.PhotoUrl" class="rounded-circle" style="width:40px;height:40px;object-fit:cover" alt="" /> }
                                    else
                                    { <span class="avatar-initials">@t.FullName[0]</span> }
                                </td>
                                <td><div style="font-weight:600">@t.FullName</div><small class="text-muted">@t.Email</small></td>
                                <td>@t.Mobile</td>
                                <td style="font-size:0.78rem">
                                    @if (portalUsers.TryGetValue(t.Id, out var un))
                                    {
                                        <div style="font-weight:600;color:var(--navy)">@un</div>
                                        <div class="text-muted">pwd: last 4 of mobile</div>
                                    }
                                    else { <span class="text-muted">—</span> }
                                </td>
                                <td>@(t.Qualification ?? "—")</td>
                                <td><small>@(t.Specialisation ?? "—")</small></td>
                                <td>
                                    <span class="badge @(t.ShowOnAboutPage ? "bg-info text-dark" : "bg-light text-dark")">
                                        @(t.ShowOnAboutPage ? "Visible" : "Hidden")
                                    </span>
                                </td>
                                <td>
                                    <span class="badge @(t.IsActive ? "bg-success" : "bg-secondary")">@(t.IsActive ? "Active" : "Inactive")</span>
                                </td>
                                <td class="d-flex gap-1">
                                    <a asp-action="Edit" asp-route-id="@t.Id" class="toolbar-btn" style="font-size:0.72rem;padding:4px 8px">
                                        <i class="fa-solid fa-pen"></i>
                                    </a>
                                    <form asp-action="Delete" asp-route-id="@t.Id" method="post" onsubmit="return confirm('Delete @t.FullName?')">
                                        @Html.AntiForgeryToken()
                                        <button type="submit" class="toolbar-btn" style="font-size:0.72rem;padding:4px 8px;background:var(--red)">
                                            <i class="fa-solid fa-trash"></i>
                                        </button>
                                    </form>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</section>
