@model Shivakala.Core.ViewModels.MpscLoginViewModel
@{
    ViewData["Title"] = "MPSC Candidate Portal Login | Shivakala Coaching Classes";
}

<section class="page-hero">
    <div class="container text-center">
        <span class="badge-soft"><i class="fa-solid fa-lock me-1"></i>Candidate Portal</span>
        <h1 class="mt-2">MPSC Candidate Login</h1>
        <p class="lead text-white-50">Access your MPSC examination dashboard, online tests, hall tickets, and scorecards.</p>
    </div>
</section>

<section class="section-shell py-5">
    <div class="container">
        <div class="row justify-content-center">
            <div class="col-md-7 col-lg-5">
                <div class="glass-card p-4 p-md-5 shadow-lg border-top border-4 border-primary">
                    <div class="text-center mb-4">
                        <div class="d-inline-flex align-items-center justify-content-center bg-primary-subtle text-primary rounded-circle mb-3" style="width:60px;height:60px;">
                            <i class="fa-solid fa-user-shield fs-4"></i>
                        </div>
                        <h4 class="fw-bold mb-1" style="color:var(--navy-dark)">Sign In</h4>
                        <p class="text-muted small">Enter your Registration No, Mobile, or Email</p>
                    </div>

                    <form asp-action="Login" method="post">
                        @Html.AntiForgeryToken()
                        <input type="hidden" asp-for="ReturnUrl" />

                        <div asp-validation-summary="All" class="alert alert-danger mb-3" style="display:@(ViewData.ModelState.IsValid ? "none" : "block")"></div>

                        <div class="mb-3">
                            <label asp-for="Identifier" class="form-label fw-semibold">Registration No / Mobile / Email</label>
                            <div class="input-group">
                                <span class="input-group-text"><i class="fa-solid fa-id-card text-muted"></i></span>
                                <input asp-for="Identifier" class="form-control form-control-lg" placeholder="e.g. SK-MPSC-2026-00001 or 9876543210" required autofocus />
                            </div>
                            <span asp-validation-for="Identifier" class="text-danger small"></span>
                        </div>

                        <div class="mb-3">
                            <div class="d-flex justify-content-between align-items-center mb-1">
                                <label asp-for="Password" class="form-label fw-semibold mb-0">Password</label>
                            </div>
                            <div class="input-group">
                                <span class="input-group-text"><i class="fa-solid fa-key text-muted"></i></span>
                                <input asp-for="Password" type="password" class="form-control form-control-lg" placeholder="••••••••" required />
                            </div>
                            <span asp-validation-for="Password" class="text-danger small"></span>
                        </div>

                        <div class="d-flex justify-content-between align-items-center mb-4">
                            <div class="form-check">
                                <input asp-for="RememberMe" class="form-check-input" type="checkbox" id="chkRemember" />
                                <label class="form-check-label small text-muted" for="chkRemember">Remember me</label>
                            </div>
                            <span class="small text-muted">Forgot password? Contact center</span>
                        </div>

                        <button type="submit" class="btn-primary-sk btn-lg w-100 py-2.5 mb-3 shadow">
                            <i class="fa-solid fa-right-to-bracket me-2"></i>Sign In to Portal
                        </button>

                        <div class="text-center pt-2 border-top">
                            <p class="text-muted small mb-0">
                                New MPSC aspirant?
                                <a asp-action="Register" class="fw-bold text-primary text-decoration-none ms-1">
                                    Register Here <i class="fa-solid fa-arrow-right small"></i>
                                </a>
                            </p>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</section>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
