@model IReadOnlyList<Shivakala.Core.ViewModels.MpscExamCardViewModel>

@if (!Model.Any())
{
    <div class="glass-card text-center py-5">
        <i class="fa-regular fa-calendar-xmark fa-3x text-muted mb-3"></i>
        <h5 class="fw-bold text-muted">No examinations scheduled in this category.</h5>
        <p class="text-muted small mb-0">Please check back later or contact the administration office.</p>
    </div>
}
else
{
    <div class="row g-4">
        @foreach (var exam in Model)
        {
            <div class="col-md-6 col-lg-4">
                <div class="glass-card p-4 h-100 d-flex flex-column justify-content-between border-top border-4 @(exam.ExamMode == "Online" ? "border-primary" : "border-success") shadow-sm">
                    <div>
                        <div class="d-flex justify-content-between align-items-center mb-2">
                            <span class="badge @(exam.ExamMode == "Online" ? "bg-primary-subtle text-primary" : "bg-success-subtle text-success") px-2.5 py-1">
                                <i class="fa-solid @(exam.ExamMode == "Online" ? "fa-wifi" : "fa-building") me-1"></i>@exam.ExamMode Test
                            </span>
                            @if (exam.HasAttempted)
                            {
                                <span class="badge bg-success"><i class="fa-solid fa-check me-1"></i>Completed</span>
                            }
                            else if (exam.IsRegistered)
                            {
                                <span class="badge bg-info text-dark"><i class="fa-solid fa-id-card me-1"></i>Registered</span>
                            }
                        </div>

                        <h5 class="fw-bold mb-2" style="color:var(--navy-dark)">@exam.Title</h5>
                        <div class="text-muted small mb-3">
                            <div><i class="fa-solid fa-book-open me-2 text-primary"></i><strong>Subject:</strong> @exam.Subject</div>
                            <div><i class="fa-solid fa-calendar me-2 text-muted"></i><strong>Date:</strong> @exam.ExamDate.ToString("dd MMM yyyy")</div>
                            <div><i class="fa-solid fa-clock me-2 text-muted"></i><strong>Duration:</strong> @exam.DurationMinutes Minutes</div>
                            <div><i class="fa-solid fa-award me-2 text-warning"></i><strong>Total Marks:</strong> @exam.TotalMarks (Pass: @exam.PassingMarks)</div>
                        </div>

                        @if (exam.ExamMode == "Offline")
                        {
                            <div class="p-2.5 bg-light rounded-2 border mb-3 small">
                                <i class="fa-solid fa-map-pin text-danger me-1"></i>Venue: <strong>@(string.IsNullOrWhiteSpace(exam.Venue) ? "Shivakala Campus Center" : exam.Venue)</strong>
                                @if (exam.Capacity.HasValue)
                                {
                                    <div class="mt-1 text-muted">
                                        <i class="fa-solid fa-chair me-1"></i>Capacity: @exam.RegisteredCount / @exam.Capacity Seats
                                    </div>
                                }
                            </div>
                        }
                    </div>

                    <div class="pt-3 border-top mt-2">
                        @if (exam.HasAttempted)
                        {
                            <a asp-action="Results" class="btn btn-outline-success w-100">
                                <i class="fa-solid fa-square-poll-vertical me-1"></i>View Scorecard
                            </a>
                        }
                        else if (exam.ExamMode == "Online" && exam.CanAttempt)
                        {
                            <a asp-controller="OnlineExam" asp-action="Details" asp-route-id="@exam.ExamId" class="btn btn-success w-100">
                                <i class="fa-solid fa-play me-1"></i>Start / Resume Exam
                            </a>
                        }
                        else if (exam.IsRegistered)
                        {
                            <button class="btn btn-secondary w-100" disabled>
                                <i class="fa-solid fa-check me-1"></i>Already Registered
                            </button>
                        }
                        else
                        {
                            <form asp-action="RegisterExam" asp-route-examId="@exam.ExamId" method="post">
                                @Html.AntiForgeryToken()
                                <button type="submit" class="btn-primary-sk w-100">
                                    <i class="fa-solid fa-calendar-check me-1"></i>Register for Test
                                </button>
                            </form>
                        }
                    </div>
                </div>
            </div>
        }
    </div>
}
