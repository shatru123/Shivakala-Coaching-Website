@{
    ViewData["Title"] = "MPSC Examination & Guidance Cell | Shivakala Coaching Classes";
}

<section class="page-hero">
    <div class="container d-flex justify-content-between align-items-center flex-wrap gap-3">
        <div>
            <span class="badge-soft"><i class="fa-solid fa-landmark-flag me-1"></i>MPSC Guidance &amp; Examination Cell</span>
            <h1 class="mt-2">MPSC स्पर्धा परीक्षा मार्गदर्शन केंद्र</h1>
            <p>Empowering civil services aspirants for Rajyaseva, Combine (Group B &amp; C), PSI, STI, and ASO examinations with structured tests and mentorship.</p>
        </div>
        <div class="d-flex gap-2 flex-wrap">
            <a asp-action="Register" class="btn-primary-sk">
                <i class="fa-solid fa-user-plus me-1"></i>Candidate Registration
            </a>
            <a asp-action="Login" class="btn-outline-light-sk">
                <i class="fa-solid fa-right-to-bracket me-1"></i>Candidate Login
            </a>
        </div>
    </div>
</section>

<section class="section-shell py-5">
    <div class="container">
        <!-- Highlights Row -->
        <div class="row g-4 mb-5">
            <div class="col-md-4">
                <div class="glass-card p-4 h-100 border-top border-4 border-primary">
                    <div class="d-flex align-items-center mb-3">
                        <div class="bg-primary text-white rounded-circle p-3 me-3" style="width:50px;height:50px;display:flex;align-items:center;justify-content:center;">
                            <i class="fa-solid fa-book-open fs-5"></i>
                        </div>
                        <h5 class="fw-bold mb-0" style="color:var(--navy-dark)">Comprehensive Coverage</h5>
                    </div>
                    <p class="text-muted small mb-0">State Services (Rajyaseva), Maharashtra Subordinate Services Group B &amp; Group C Non-Gazetted exams covered systematically.</p>
                </div>
            </div>
            <div class="col-md-4">
                <div class="glass-card p-4 h-100 border-top border-4 border-success">
                    <div class="d-flex align-items-center mb-3">
                        <div class="bg-success text-white rounded-circle p-3 me-3" style="width:50px;height:50px;display:flex;align-items:center;justify-content:center;">
                            <i class="fa-solid fa-laptop fs-5"></i>
                        </div>
                        <h5 class="fw-bold mb-0" style="color:var(--navy-dark)">Online &amp; Offline Mock Tests</h5>
                    </div>
                    <p class="text-muted small mb-0">Regular high-yield mock tests following the latest MPSC syllabus, negative marking scheme, and time constraints with instant analytics.</p>
                </div>
            </div>
            <div class="col-md-4">
                <div class="glass-card p-4 h-100 border-top border-4 border-warning">
                    <div class="d-flex align-items-center mb-3">
                        <div class="bg-warning text-dark rounded-circle p-3 me-3" style="width:50px;height:50px;display:flex;align-items:center;justify-content:center;">
                            <i class="fa-solid fa-chart-line fs-5"></i>
                        </div>
                        <h5 class="fw-bold mb-0" style="color:var(--navy-dark)">Performance Tracking</h5>
                    </div>
                    <p class="text-muted small mb-0">Individual candidate dashboard with score tracking, topic-wise strengths and weaknesses analysis, and statewide rankings.</p>
                </div>
            </div>
        </div>

        <!-- Target Examinations Grid -->
        <div class="glass-card p-4 p-md-5 mb-5">
            <div class="text-center mb-4">
                <span class="badge-soft mb-2"><i class="fa-solid fa-award me-1"></i>Exam Categories</span>
                <h3 class="fw-bold" style="color:var(--navy-dark)">Exams We Prepare You For</h3>
                <p class="text-muted small">Specialized curriculum alignment for key Maharashtra Public Service Commission examinations</p>
            </div>

            <div class="row g-4">
                <div class="col-md-6 col-lg-4">
                    <div class="p-3 border rounded-3 h-100 bg-light-subtle">
                        <div class="fw-bold text-primary mb-1"><i class="fa-solid fa-building-columns me-2"></i>MPSC Rajyaseva (State Services)</div>
                        <p class="text-muted small mb-2">Deputy Collector, DSP/ACP, Tehsildar, Naib Tehsildar, Block Development Officer (BDO).</p>
                        <span class="badge bg-primary-subtle text-primary">Prelims + Mains Pattern</span>
                    </div>
                </div>
                <div class="col-md-6 col-lg-4">
                    <div class="p-3 border rounded-3 h-100 bg-light-subtle">
                        <div class="fw-bold text-primary mb-1"><i class="fa-solid fa-shield-halved me-2"></i>Police Sub-Inspector (PSI)</div>
                        <p class="text-muted small mb-2">Focused preparation for Group B Combine Prelims, Physical Test orientation, and Law papers.</p>
                        <span class="badge bg-success-subtle text-success">Combine Group B</span>
                    </div>
                </div>
                <div class="col-md-6 col-lg-4">
                    <div class="p-3 border rounded-3 h-100 bg-light-subtle">
                        <div class="fw-bold text-primary mb-1"><i class="fa-solid fa-money-check-dollar me-2"></i>State Tax Inspector (STI)</div>
                        <p class="text-muted small mb-2">In-depth economics, tax laws, GST framework, and Subordinate Services Combined syllabus.</p>
                        <span class="badge bg-info-subtle text-info">Combine Group B</span>
                    </div>
                </div>
                <div class="col-md-6 col-lg-4">
                    <div class="p-3 border rounded-3 h-100 bg-light-subtle">
                        <div class="fw-bold text-primary mb-1"><i class="fa-solid fa-file-signature me-2"></i>Assistant Section Officer (ASO)</div>
                        <p class="text-muted small mb-2">Mantralaya administration, Constitution of India, General Knowledge &amp; Secretariat procedures.</p>
                        <span class="badge bg-warning-subtle text-dark">Combine Group B</span>
                    </div>
                </div>
                <div class="col-md-6 col-lg-4">
                    <div class="p-3 border rounded-3 h-100 bg-light-subtle">
                        <div class="fw-bold text-primary mb-1"><i class="fa-solid fa-users me-2"></i>MPSC Group C Services</div>
                        <p class="text-muted small mb-2">Clerk-Typist, Tax Assistant, Excise Sub-Inspector, Technical Assistant, Industrial Inspector.</p>
                        <span class="badge bg-secondary-subtle text-secondary">Combine Group C</span>
                    </div>
                </div>
                <div class="col-md-6 col-lg-4">
                    <div class="p-3 border rounded-3 h-100 bg-light-subtle">
                        <div class="fw-bold text-primary mb-1"><i class="fa-solid fa-tree me-2"></i>Maharashtra Forest / Agri / Engg</div>
                        <p class="text-muted small mb-2">Combined civil prelims preparation with standard GS test series and Marathi grammar focus.</p>
                        <span class="badge bg-dark-subtle text-dark">Technical Services</span>
                    </div>
                </div>
            </div>
        </div>

        <!-- Registration Banner CTA -->
        <div class="card border-0 text-white p-4 p-md-5 rounded-4 shadow-lg text-center" style="background: linear-gradient(135deg, var(--navy-dark, #1B2B6B) 0%, #2948b0 100%);">
            <h2 class="fw-bold mb-3">Begin Your Civil Services Journey With Shivakala</h2>
            <p class="lead mx-auto mb-4" style="max-width: 700px; opacity: 0.95;">
                Register today to get your dedicated MPSC Candidate ID, access all upcoming mock examination schedules, and evaluate your preparation against real competitive standards.
            </p>
            <div class="d-flex justify-content-center gap-3 flex-wrap">
                <a asp-action="Register" class="btn btn-warning btn-lg fw-bold px-4 py-2 text-dark shadow-sm">
                    <i class="fa-solid fa-id-card me-2"></i>Register As MPSC Candidate
                </a>
                <a asp-controller="OnlineExam" asp-action="Index" class="btn btn-outline-light btn-lg px-4 py-2">
                    <i class="fa-solid fa-laptop-code me-2"></i>View Online Exams
                </a>
                <a asp-action="Login" class="btn btn-light btn-lg px-4 py-2 text-primary">
                    <i class="fa-solid fa-right-to-bracket me-2"></i>Existing Candidate Login
                </a>
            </div>
        </div>
    </div>
</section>
