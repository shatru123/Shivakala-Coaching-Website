@model Shivakala.Core.ViewModels.MpscProfileViewModel
@{
    ViewData["Title"] = "My Profile | Shivakala MPSC Cell";
}

<section class="page-hero">
    <div class="container d-flex justify-content-between align-items-center flex-wrap gap-3">
        <div>
            <span class="badge-soft"><i class="fa-solid fa-user me-1"></i>Candidate Profile</span>
            <h1 class="mt-2">Update Candidate Profile</h1>
            <p>Maintain your up-to-date contact information, educational qualifications, and examination preferences.</p>
        </div>
        <a asp-action="Dashboard" class="btn btn-outline-light btn-sm">
            <i class="fa-solid fa-arrow-left me-1"></i>Back to Dashboard
        </a>
    </div>
</section>

<section class="section-shell py-5">
    <div class="container">
        <div class="row justify-content-center">
            <div class="col-lg-10">

                @if (TempData["SuccessMessage"] != null)
                {
                    <div class="alert alert-success alert-dismissible fade show mb-4 shadow-sm" role="alert">
                        <i class="fa-solid fa-circle-check me-2"></i>@TempData["SuccessMessage"]
                        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
                    </div>
                }

                <form asp-action="Profile" method="post" enctype="multipart/form-data">
                    @Html.AntiForgeryToken()
                    <input type="hidden" asp-for="Id" />
                    <input type="hidden" asp-for="RegistrationNumber" />
                    <input type="hidden" asp-for="CurrentPhotoUrl" />

                    <div asp-validation-summary="All" class="alert alert-danger mb-4 shadow-sm" style="display:@(ViewData.ModelState.IsValid ? "none" : "block")"></div>

                    <!-- PROFILE PHOTO & REGISTRATION INFO -->
                    <div class="glass-card p-4 p-md-5 mb-4">
                        <div class="d-flex align-items-center gap-4 flex-wrap pb-4 border-bottom mb-4">
                            <div class="rounded-circle overflow-hidden bg-light d-flex align-items-center justify-content-center border shadow-sm" style="width:100px;height:100px;">
                                @if (!string.IsNullOrWhiteSpace(Model.CurrentPhotoUrl))
                                {
                                    <img src="@Model.CurrentPhotoUrl" alt="@Model.FullName" style="width:100%;height:100%;object-fit:cover;" />
                                }
                                else
                                {
                                    <i class="fa-solid fa-user fa-3x text-secondary"></i>
                                }
                            </div>
                            <div>
                                <span class="badge bg-primary px-3 py-1.5 font-monospace fs-6">@Model.RegistrationNumber</span>
                                <h4 class="fw-bold mt-2 mb-1" style="color:var(--navy-dark)">@Model.FullName</h4>
                                <div class="mt-2">
                                    <label asp-for="NewPhotoFile" class="form-label small fw-semibold">Upload New Photo</label>
                                    <input asp-for="NewPhotoFile" type="file" class="form-control form-control-sm" accept="image/*" />
                                </div>
                            </div>
                        </div>

                        <h5 class="fw-bold mb-3 text-primary"><i class="fa-solid fa-id-card me-2"></i>Personal Information</h5>
                        <div class="row g-3 mb-4">
                            <div class="col-md-6">
                                <label asp-for="FullName" class="form-label fw-semibold">Full Name <span class="text-danger">*</span></label>
                                <input asp-for="FullName" class="form-control" required />
                                <span asp-validation-for="FullName" class="text-danger small"></span>
                            </div>
                            <div class="col-md-6">
                                <label asp-for="FullNameMarathi" class="form-label fw-semibold">पूर्ण नाव (मराठीत)</label>
                                <input asp-for="FullNameMarathi" class="form-control" />
                                <span asp-validation-for="FullNameMarathi" class="text-danger small"></span>
                            </div>
                            <div class="col-md-4">
                                <label asp-for="DateOfBirth" class="form-label fw-semibold">Date of Birth <span class="text-danger">*</span></label>
                                <input asp-for="DateOfBirth" type="date" class="form-control" required />
                                <span asp-validation-for="DateOfBirth" class="text-danger small"></span>
                            </div>
                            <div class="col-md-4">
                                <label asp-for="Gender" class="form-label fw-semibold">Gender <span class="text-danger">*</span></label>
                                <select asp-for="Gender" class="form-select" required>
                                    <option value="Male">Male</option>
                                    <option value="Female">Female</option>
                                    <option value="Other">Other</option>
                                </select>
                            </div>
                            <div class="col-md-4">
                                <label asp-for="Mobile" class="form-label fw-semibold">Mobile <span class="text-danger">*</span></label>
                                <input asp-for="Mobile" class="form-control" maxlength="10" required />
                                <span asp-validation-for="Mobile" class="text-danger small"></span>
                            </div>
                            <div class="col-md-6">
                                <label asp-for="AlternateMobile" class="form-label fw-semibold">Alternate Mobile</label>
                                <input asp-for="AlternateMobile" class="form-control" maxlength="10" />
                            </div>
                            <div class="col-md-6">
                                <label asp-for="Email" class="form-label fw-semibold">Email <span class="text-danger">*</span></label>
                                <input asp-for="Email" type="email" class="form-control" required />
                                <span asp-validation-for="Email" class="text-danger small"></span>
                            </div>
                        </div>

                        <h5 class="fw-bold mb-3 text-primary"><i class="fa-solid fa-location-dot me-2"></i>Address</h5>
                        <div class="row g-3 mb-4">
                            <div class="col-12">
                                <label asp-for="Address" class="form-label fw-semibold">Address <span class="text-danger">*</span></label>
                                <textarea asp-for="Address" class="form-control" rows="2" required></textarea>
                            </div>
                            <div class="col-md-4">
                                <label asp-for="City" class="form-label fw-semibold">City / Taluka</label>
                                <input asp-for="City" class="form-control" />
                            </div>
                            <div class="col-md-4">
                                <label asp-for="District" class="form-label fw-semibold">District <span class="text-danger">*</span></label>
                                <input asp-for="District" class="form-control" required />
                            </div>
                            <div class="col-md-4">
                                <label asp-for="Pincode" class="form-label fw-semibold">Pincode</label>
                                <input asp-for="Pincode" class="form-control" maxlength="6" />
                            </div>
                        </div>

                        <h5 class="fw-bold mb-3 text-primary"><i class="fa-solid fa-graduation-cap me-2"></i>Education &amp; Examination</h5>
                        <div class="row g-3 mb-4">
                            <div class="col-md-4">
                                <label asp-for="HighestQualification" class="form-label fw-semibold">Highest Qualification</label>
                                <select asp-for="HighestQualification" class="form-select">
                                    <option value="Graduate">Graduate</option>
                                    <option value="PostGraduate">Post Graduate</option>
                                    <option value="Diploma">Diploma</option>
                                    <option value="12th">12th Standard</option>
                                    <option value="Other">Other</option>
                                </select>
                            </div>
                            <div class="col-md-4">
                                <label asp-for="DegreeOrCourse" class="form-label fw-semibold">Degree / Course</label>
                                <input asp-for="DegreeOrCourse" class="form-control" />
                            </div>
                            <div class="col-md-4">
                                <label asp-for="University" class="form-label fw-semibold">University</label>
                                <input asp-for="University" class="form-control" />
                            </div>

                            <div class="col-md-4">
                                <label asp-for="PreferredExam" class="form-label fw-semibold">Target Examination</label>
                                <select asp-for="PreferredExam" class="form-select">
                                    <option value="Rajyaseva">MPSC Rajyaseva (State Services)</option>
                                    <option value="Combine Group B">Combine Group B</option>
                                    <option value="Combine Group C">Combine Group C</option>
                                    <option value="PSI">PSI</option>
                                    <option value="STI">STI</option>
                                    <option value="ASO">ASO</option>
                                    <option value="Technical Services">Technical Services</option>
                                </select>
                            </div>
                            <div class="col-md-4">
                                <label asp-for="PreparationLevel" class="form-label fw-semibold">Preparation Level</label>
                                <select asp-for="PreparationLevel" class="form-select">
                                    <option value="Beginner">Beginner</option>
                                    <option value="Intermediate">Intermediate</option>
                                    <option value="Advanced">Advanced</option>
                                </select>
                            </div>
                            <div class="col-md-4">
                                <label asp-for="TargetAttemptYear" class="form-label fw-semibold">Target Year</label>
                                <input asp-for="TargetAttemptYear" type="number" class="form-control" min="2024" max="2032" />
                            </div>

                            <div class="col-md-6">
                                <label asp-for="Category" class="form-label fw-semibold">Category</label>
                                <select asp-for="Category" class="form-select">
                                    <option value="Open">Open</option>
                                    <option value="OBC">OBC</option>
                                    <option value="EWS">EWS</option>
                                    <option value="SC">SC</option>
                                    <option value="ST">ST</option>
                                    <option value="VJ/NT">VJ/NT</option>
                                </select>
                            </div>
                            <div class="col-md-6">
                                <label class="form-label fw-semibold d-block">Reservation Certificates</label>
                                <div class="form-check form-check-inline">
                                    <input asp-for="CasteCertificateAvailable" class="form-check-input" type="checkbox" id="chkCaste" />
                                    <label class="form-check-label small" for="chkCaste">Caste Cert</label>
                                </div>
                                <div class="form-check form-check-inline">
                                    <input asp-for="NonCreamyLayerCertificateAvailable" class="form-check-input" type="checkbox" id="chkNCL" />
                                    <label class="form-check-label small" for="chkNCL">NCL Cert</label>
                                </div>
                                <div class="form-check form-check-inline">
                                    <input asp-for="EwsCertificateAvailable" class="form-check-input" type="checkbox" id="chkEws" />
                                    <label class="form-check-label small" for="chkEws">EWS Cert</label>
                                </div>
                            </div>
                        </div>

                        <div class="d-flex justify-content-end gap-2 pt-3 border-top">
                            <a asp-action="Dashboard" class="btn btn-outline-secondary">Cancel</a>
                            <button type="submit" class="btn-primary-sk px-4 py-2">
                                <i class="fa-solid fa-floppy-disk me-1"></i>Save Profile Changes
                            </button>
                        </div>
                    </div>
                </form>

            </div>
        </div>
    </div>
</section>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
