@model Shivakala.Core.ViewModels.MpscCandidateDashboardViewModel
@{
    ViewData["Title"] = "MPSC Candidate Dashboard | Shivakala Coaching Classes";
    var c = Model.Candidate;
}

<section class="page-hero">
    <div class="container d-flex justify-content-between align-items-center flex-wrap gap-3">
        <div class="d-flex align-items-center gap-3">
            <div class="rounded-circle overflow-hidden bg-white text-primary d-flex align-items-center justify-content-center shadow" style="width:70px;height:70px;">
                @if (!string.IsNullOrWhiteSpace(c.PhotoUrl))
                {
                    <img src="@c.PhotoUrl" alt="@c.FullName" style="width:100%;height:100%;object-fit:cover;" />
                }
                else
                {
                    <i class="fa-solid fa-user-graduate fs-2 text-primary"></i>
                }
            </div>
            <div>
                <span class="badge-soft mb-1"><i class="fa-solid fa-id-card me-1"></i>@c.RegistrationNumber</span>
                <h2 class="mt-1 mb-0 text-white">@c.FullName</h2>
                <p class="mb-0 text-white-50 small">
                    Targeting: <strong>@c.PreferredExam</strong> | District: <strong>@c.District</strong>
                </p>
            </div>
        </div>
        <div class="d-flex gap-2 flex-wrap">
            <a asp-action="Profile" class="btn btn-outline-light btn-sm">
                <i class="fa-solid fa-user-pen me-1"></i>Edit Profile
            </a>
            <a asp-action="ChangePassword" class="btn btn-outline-light btn-sm">
                <i class="fa-solid fa-key me-1"></i>Change Password
            </a>
            <a asp-action="Logout" class="btn btn-danger btn-sm">
                <i class="fa-solid fa-power-off me-1"></i>Logout
            </a>
        </div>
    </div>
</section>

<section class="section-shell py-4">
    <div class="container">

        <!-- PROFILE COMPLETION PROGRESS -->
        <div class="glass-card p-4 mb-4">
            <div class="d-flex justify-content-between align-items-center mb-2 flex-wrap gap-2">
                <span class="fw-bold" style="color:var(--navy-dark)">
                    <i class="fa-solid fa-chart-pie me-2 text-primary"></i>Profile Completion
                </span>
                <span class="badge @(Model.ProfileCompletionPercentage == 100 ? "bg-success" : "bg-warning text-dark") px-3 py-1.5 rounded-pill">
                    @Model.ProfileCompletionPercentage% Completed
                </span>
            </div>
            <div class="progress mb-2" style="height: 10px;">
                <div class="progress-bar @(Model.ProfileCompletionPercentage == 100 ? "bg-success" : "bg-primary")" role="progressbar" style="width: @Model.ProfileCompletionPercentage%;" aria-valuenow="@Model.ProfileCompletionPercentage" aria-valuemin="0" aria-valuemax="100"></div>
            </div>
            @if (Model.MissingFields.Any())
            {
                <div class="small text-muted mt-2">
                    <i class="fa-solid fa-circle-exclamation text-warning me-1"></i>
                    To complete your profile, please add: <strong>@string.Join(", ", Model.MissingFields)</strong>.
                    <a asp-action="Profile" class="ms-1 fw-semibold text-primary">Update now &raquo;</a>
                </div>
            }
        </div>

        <!-- STATS ROW -->
        <div class="row g-3 mb-4">
            <div class="col-sm-6 col-lg-3">
                <div class="glass-card p-3 d-flex align-items-center border-start border-4 border-primary">
                    <div class="bg-primary-subtle text-primary rounded-circle p-3 me-3" style="width:48px;height:48px;display:flex;align-items:center;justify-content:center;">
                        <i class="fa-solid fa-book-open"></i>
                    </div>
                    <div>
                        <div class="fs-4 fw-bold">@Model.AvailableExamsCount</div>
                        <div class="text-muted small">Available Tests</div>
                    </div>
                </div>
            </div>
            <div class="col-sm-6 col-lg-3">
                <div class="glass-card p-3 d-flex align-items-center border-start border-4 border-info">
                    <div class="bg-info-subtle text-info rounded-circle p-3 me-3" style="width:48px;height:48px;display:flex;align-items:center;justify-content:center;">
                        <i class="fa-solid fa-calendar-check"></i>
                    </div>
                    <div>
                        <div class="fs-4 fw-bold">@Model.RegisteredExamsCount</div>
                        <div class="text-muted small">Registered Tests</div>
                    </div>
                </div>
            </div>
            <div class="col-sm-6 col-lg-3">
                <div class="glass-card p-3 d-flex align-items-center border-start border-4 border-warning">
                    <div class="bg-warning-subtle text-warning rounded-circle p-3 me-3" style="width:48px;height:48px;display:flex;align-items:center;justify-content:center;">
                        <i class="fa-solid fa-hourglass-half"></i>
                    </div>
                    <div>
                        <div class="fs-4 fw-bold">@Model.UpcomingExamsCount</div>
                        <div class="text-muted small">Upcoming Schedules</div>
                    </div>
                </div>
            </div>
            <div class="col-sm-6 col-lg-3">
                <div class="glass-card p-3 d-flex align-items-center border-start border-4 border-success">
                    <div class="bg-success-subtle text-success rounded-circle p-3 me-3" style="width:48px;height:48px;display:flex;align-items:center;justify-content:center;">
                        <i class="fa-solid fa-square-poll-vertical"></i>
                    </div>
                    <div>
                        <div class="fs-4 fw-bold">@Model.CompletedExamsCount</div>
                        <div class="text-muted small">Tests Completed</div>
                    </div>
                </div>
            </div>
        </div>

        <!-- EXAMINATIONS & RECENT RESULTS -->
        <div class="row g-4">
            <!-- Left: Available & Registered Exams -->
            <div class="col-lg-7">
                <div class="glass-card p-4 h-100">
                    <div class="d-flex justify-content-between align-items-center mb-3 pb-2 border-bottom">
                        <h5 class="fw-bold mb-0" style="color:var(--navy-dark)">
                            <i class="fa-solid fa-laptop-code me-2 text-primary"></i>MPSC Examinations
                        </h5>
                        <a asp-action="Exams" class="btn btn-outline-primary btn-sm">View All &raquo;</a>
                    </div>

                    @if (!Model.AvailableExams.Any())
                    {
                        <div class="text-center py-5 text-muted">
                            <i class="fa-regular fa-clipboard fa-3x mb-3 text-muted"></i>
                            <p class="mb-0">No examinations are currently scheduled for MPSC candidates.</p>
                        </div>
                    }
                    else
                    {
                        <div class="d-flex flex-column gap-3">
                            @foreach (var exam in Model.AvailableExams.Take(5))
                            {
                                <div class="p-3 border rounded-3 bg-light-subtle">
                                    <div class="d-flex justify-content-between align-items-start gap-2 mb-2">
                                        <div>
                                            <span class="badge @(exam.ExamMode == "Online" ? "bg-info text-dark" : "bg-secondary") mb-1">
                                                <i class="fa-solid @(exam.ExamMode == "Online" ? "fa-wifi" : "fa-building") me-1"></i>@exam.ExamMode
                                            </span>
                                            <h6 class="fw-bold mb-1">@exam.Title</h6>
                                            <div class="text-muted small">
                                                <span><i class="fa-solid fa-book-open me-1"></i>@exam.Subject</span>
                                                <span class="mx-2">•</span>
                                                <span><i class="fa-solid fa-clock me-1"></i>@exam.DurationMinutes mins</span>
                                                <span class="mx-2">•</span>
                                                <span><i class="fa-solid fa-star me-1 text-warning"></i>@exam.TotalMarks Marks</span>
                                            </div>
                                        </div>
                                        <div>
                                            @if (exam.HasAttempted)
                                            {
                                                <span class="badge bg-success-subtle text-success p-2">
                                                    <i class="fa-solid fa-check-circle me-1"></i>Attempted
                                                </span>
                                            }
                                            else if (exam.CanAttempt)
                                            {
                                                <a asp-controller="OnlineExam" asp-action="Details" asp-route-id="@exam.ExamId" class="btn btn-success btn-sm px-3">
                                                    <i class="fa-solid fa-play me-1"></i>Take Test
                                                </a>
                                            }
                                            else if (exam.IsRegistered)
                                            {
                                                <span class="badge bg-primary-subtle text-primary p-2">
                                                    <i class="fa-solid fa-check me-1"></i>Registered
                                                </span>
                                            }
                                            else
                                            {
                                                <form asp-action="RegisterExam" asp-route-examId="@exam.ExamId" method="post" class="d-inline">
                                                    @Html.AntiForgeryToken()
                                                    <button type="submit" class="btn btn-outline-primary btn-sm">
                                                        <i class="fa-solid fa-calendar-plus me-1"></i>Register
                                                    </button>
                                                </form>
                                            }
                                        </div>
                                    </div>
                                    @if (exam.ExamMode == "Offline" && !string.IsNullOrWhiteSpace(exam.Venue))
                                    {
                                        <div class="small text-muted bg-white p-2 rounded border mt-2">
                                            <i class="fa-solid fa-location-dot text-danger me-1"></i>Venue: <strong>@exam.Venue</strong>
                                            @if (exam.Capacity.HasValue)
                                            {
                                                <span class="ms-2">(Capacity: @exam.Capacity Seats)</span>
                                            }
                                        </div>
                                    }
                                </div>
                            }
                        </div>
                    }
                </div>
            </div>

            <!-- Right: Recent Test Results -->
            <div class="col-lg-5">
                <div class="glass-card p-4 h-100">
                    <div class="d-flex justify-content-between align-items-center mb-3 pb-2 border-bottom">
                        <h5 class="fw-bold mb-0" style="color:var(--navy-dark)">
                            <i class="fa-solid fa-trophy me-2 text-warning"></i>Recent Scorecards
                        </h5>
                        <a asp-action="Results" class="btn btn-outline-primary btn-sm">History &raquo;</a>
                    </div>

                    @if (!Model.RecentResults.Any())
                    {
                        <div class="text-center py-5 text-muted">
                            <i class="fa-regular fa-star fa-3x mb-3 text-muted"></i>
                            <p class="mb-0">No examination results available yet.</p>
                            <small>Attempt an exam to see your scorecard and ranking here.</small>
                        </div>
                    }
                    else
                    {
                        <div class="d-flex flex-column gap-3">
                            @foreach (var res in Model.RecentResults)
                            {
                                <div class="p-3 border rounded-3 bg-light-subtle d-flex justify-content-between align-items-center">
                                    <div>
                                        <h6 class="fw-bold mb-1">@res.ExamTitle</h6>
                                        <div class="text-muted small">@res.Subject • @res.Date.ToString("dd MMM yyyy")</div>
                                        @if (res.Rank.HasValue)
                                        {
                                            <span class="badge bg-warning text-dark mt-1">
                                                <i class="fa-solid fa-medal me-1"></i>Rank #@res.Rank
                                            </span>
                                        }
                                    </div>
                                    <div class="text-end">
                                        <div class="fs-5 fw-bold @(res.IsPassed ? "text-success" : "text-danger")">
                                            @(res.MarksObtained?.ToString("F1") ?? "0") <small class="text-muted fs-6">/ @res.TotalMarks</small>
                                        </div>
                                        <span class="badge @(res.IsPassed ? "bg-success" : "bg-danger")">
                                            @(res.IsPassed ? "Passed" : "Failed")
                                        </span>
                                    </div>
                                </div>
                            }
                        </div>
                    }
                </div>
            </div>
        </div>

    </div>
</section>
