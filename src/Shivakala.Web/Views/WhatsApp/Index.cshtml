@{
    ViewData["Title"] = "WhatsApp Broadcast | Admin";
    var activeProvider = (string)ViewBag.ActiveProvider;
    var isConfigured = (bool)ViewBag.IsConfigured;
    var isAuthenticated = (bool)ViewBag.IsAuthenticated;
}

<section class="page-hero" style="background:linear-gradient(135deg,#075e54,#128c7e)">
    <div class="container d-flex justify-content-between align-items-center flex-wrap gap-3">

        <div>
            <span class="badge-soft">
                <i class="fa-brands fa-whatsapp me-1"></i>Admin
            </span>

            <h1>WhatsApp Broadcast</h1>

            <p>Send messages to parents &amp; students instantly</p>
        </div>

        <div class="d-flex align-items-center flex-wrap gap-2">
            <span id="statusBadge"
                  class="badge @(isConfigured && isAuthenticated ? "bg-success" : "bg-warning text-dark")"
                  style="font-size:.9rem;padding:8px 18px">

                @if (activeProvider == "CloudApi")
                {
                    @(isConfigured ? "✓ Meta Cloud API Connected" : "⚠ Meta Cloud API Config Required")
                }
                else if (activeProvider == "Sidecar")
                {
                    @(isAuthenticated ? "✓ Sidecar Connected" : "⚠ Scan QR Code to Connect")
                }
                else
                {
                    <text>⚡ 1-Click WhatsApp Direct Launcher</text>
                }
            </span>

            @if (activeProvider == "Sidecar" && (bool)ViewBag.IsSidecarConfigured)
            {
                <form asp-action="Disconnect" method="post" class="ms-2">
                    @Html.AntiForgeryToken()
                    <button type="submit" class="btn btn-sm btn-light" style="border-radius:999px">
                        <i class="fa-solid fa-link-slash me-1"></i> Disconnect
                    </button>
                </form>
            }
        </div>

    </div>
</section>

<section class="section-shell pt-0">

    <div class="container">

        @if (TempData["SuccessMessage"] is string m)
        {
            <div class="alert alert-success">@m</div>
        }

        <div class="row g-4">

            <!-- PROVIDER SELECTION & CLOUD API CONFIG INFO -->
            <div class="col-12">
                <div class="glass-card p-3" style="background:rgba(18,140,126,0.05);border:1px solid rgba(18,140,126,0.2)">
                    <div class="d-flex align-items-center justify-content-between flex-wrap gap-2">
                        <div>
                            <strong>Active WhatsApp Method:</strong>
                            <span class="badge bg-dark ms-1">@activeProvider</span>
                            @if (activeProvider == "CloudApi")
                            {
                                <span class="text-muted small ms-2">Official Meta API (1,000 Free Messages / Month, No Sidecar Required)</span>
                            }
                            else if (activeProvider == "DirectLink")
                            {
                                <span class="text-muted small ms-2">1-Click Direct WhatsApp Launcher (Zero Configuration)</span>
                            }
                        </div>
                        <button class="btn btn-sm btn-outline-dark" type="button" data-bs-toggle="collapse" data-bs-target="#configGuide">
                            <i class="fa-solid fa-gear me-1"></i> Provider Setup Guide
                        </button>
                    </div>

                    <div class="collapse mt-3" id="configGuide">
                        <div class="card card-body bg-white text-dark small" style="border-radius:10px">
                            <h6 class="fw-bold mb-2"><i class="fa-brands fa-whatsapp text-success me-1"></i> Official Meta WhatsApp Cloud API (Recommended)</h6>
                            <ol class="mb-3">
                                <li>Create a free developer app at <a href="https://developers.facebook.com/" target="_blank" rel="noopener">Meta for Developers</a> and add <strong>WhatsApp</strong>.</li>
                                <li>Copy your <strong>Phone Number ID</strong> and <strong>Temporary/Permanent Access Token</strong>.</li>
                                <li>Add them to <code>appsettings.Production.json</code> on SmarterASP.NET:
                                    <pre class="bg-light p-2 mt-1 rounded text-dark"><code>"WhatsApp": {
  "Provider": "CloudApi",
  "PhoneNumberId": "YOUR_PHONE_NUMBER_ID",
  "AccessToken": "YOUR_ACCESS_TOKEN"
}</code></pre>
                                </li>
                                <li>Done! Messages will send directly from C# via Meta Graph API without any Node.js sidecar or QR scanning.</li>
                            </ol>
                            <h6 class="fw-bold mb-1"><i class="fa-solid fa-bolt text-warning me-1"></i> Direct 1-Click WhatsApp Launcher (Zero Setup)</h6>
                            <p class="mb-0 text-muted">Select <strong>Provider = "DirectLink"</strong> or use the <em>"Generate 1-Click WhatsApp Links"</em> button below to send broadcasts directly via WhatsApp Web or WhatsApp App on your phone/PC.</p>
                        </div>
                    </div>
                </div>
            </div>

            @if (activeProvider == "Sidecar" && !isAuthenticated)
            {
                <!-- QR PANEL -->
                <div class="col-md-4">
                    <div class="glass-card text-center">
                        <h5 class="mb-2">Step 1 — Scan QR Code</h5>
                        <p class="text-muted small mb-3">Open WhatsApp → Linked Devices → Link a Device</p>
                        <div id="qrContainer" style="min-height:230px;display:flex;align-items:center;justify-content:center;flex-direction:column">
                            <img id="qrImg" src="/admin/whatsapp/qr.png" alt="WhatsApp QR" style="max-width:210px;border-radius:12px;border:4px solid #128c7e" onerror="this.style.display='none';document.getElementById('qrError').style.display='block'" />
                            <div id="qrError" style="display:none" class="text-muted mt-2">
                                <i class="fa-solid fa-triangle-exclamation fa-2x mb-2" style="color:var(--gold)"></i>
                                <p class="small">Could not reach the WhatsApp sidecar at <code>@ViewBag.SidecarBaseUrl</code>.</p>
                            </div>
                        </div>
                        <button onclick="refreshQr()" class="btn-outline-sk mt-3 w-100">
                            <i class="fa-solid fa-rotate"></i> Refresh QR
                        </button>
                    </div>
                </div>

                <div class="col-md-8">
                    @await Html.PartialAsync("_BroadcastForm")
                </div>
            }
            else
            {
                <div class="col-12">
                    @await Html.PartialAsync("_BroadcastForm")
                </div>
            }

            <!-- RECENT BROADCASTS LOG -->
            <div class="col-12">
                <div class="glass-card">
                    <h5 class="mb-3">Recent Broadcasts</h5>
                    <div class="table-responsive">
                        <table class="table admin-table table-sm">
                            <thead>
                                <tr>
                                    <th>Date</th>
                                    <th>Message</th>
                                    <th>Audience</th>
                                    <th>Sent</th>
                                    <th>Failed</th>
                                    <th>Status</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var n in (IReadOnlyList<Shivakala.Core.Entities.Notification>)ViewBag.RecentNotifs)
                                {
                                    var badgeClass = n.Status == "Sent" ? "bg-success" : n.Status == "Failed" ? "bg-danger" : "bg-warning text-dark";
                                    <tr>
                                        <td style="font-size:.78rem;white-space:nowrap">@n.CreatedDate.ToLocalTime().ToString("dd MMM HH:mm")</td>
                                        <td style="font-size:.8rem;max-width:280px;overflow:hidden;text-overflow:ellipsis;white-space:nowrap">@n.Message</td>
                                        <td style="font-size:.78rem">@n.Audience</td>
                                        <td><span class="badge bg-success">@n.DeliveredCount</span></td>
                                        <td><span class="badge bg-danger">@n.FailedCount</span></td>
                                        <td><span class="badge @badgeClass">@n.Status</span></td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>

        </div>

    </div>

</section>

<!-- 1-CLICK WHATSAPP LAUNCHER MODAL -->
<div class="modal fade" id="directLinksModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-lg">
        <div class="modal-content" style="border-radius:16px">
            <div class="modal-header" style="background:linear-gradient(135deg,#075e54,#128c7e);color:#fff">
                <h5 class="modal-title"><i class="fa-brands fa-whatsapp me-2"></i>1-Click WhatsApp Dispatch Links</h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body">
                <p class="text-muted small">Click any parent's name below to open WhatsApp Web or Desktop App with your message pre-filled:</p>
                <div id="linksList" class="list-group list-group-flush" style="max-height:350px;overflow-y:auto"></div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
<script>
document.querySelectorAll('.tpl-btn').forEach(function(btn){
    btn.addEventListener('click', function(){
        document.getElementById('msgBox').value = this.getAttribute('data-text');
    });
});

function generateDirectLinks(){
    var msg = document.getElementById('msgBox').value;
    if(!msg.trim()){
        alert('Please enter a message first.');
        return;
    }
    var audience = document.querySelector('.audience-opt:checked').value;
    var batchId = document.getElementById('batchId').value;

    fetch('/admin/whatsapp/links?audience=' + audience + '&batchId=' + batchId + '&message=' + encodeURIComponent(msg))
        .then(r => r.json())
        .then(data => {
            var container = document.getElementById('linksList');
            container.innerHTML = '';
            if(data.length === 0){
                container.innerHTML = '<div class="alert alert-info">No contacts found for this selection.</div>';
            } else {
                data.forEach(function(item){
                    var a = document.createElement('a');
                    a.href = item.url;
                    a.target = '_blank';
                    a.className = 'list-group-item list-group-item-action d-flex justify-content-between align-items-center py-2';
                    a.innerHTML = '<div><strong>' + item.name + '</strong> <span class="text-muted small me-2">(' + item.mobile + ')</span></div>' +
                                  '<span class="btn btn-sm btn-success"><i class="fa-brands fa-whatsapp me-1"></i> Send</span>';
                    container.appendChild(a);
                });
            }
            var modal = new bootstrap.Modal(document.getElementById('directLinksModal'));
            modal.show();
        });
}

@if (activeProvider == "Sidecar" && !isAuthenticated && (bool)ViewBag.IsSidecarConfigured)
{
<text>
var qrPoll = setInterval(function(){
    fetch('/admin/whatsapp/status')
        .then(r => r.json())
        .then(d => {
            if(d.authenticated){
                clearInterval(qrPoll);
                document.getElementById('statusBadge').textContent = '✓ Sidecar Connected';
                document.getElementById('statusBadge').className = 'badge bg-success';
                document.getElementById('qrContainer').innerHTML =
                    '<div class="text-success"><i class="fa-solid fa-circle-check fa-3x"></i><p class="mt-2 fw-600">WhatsApp Connected!</p></div>';
            } else {
                refreshQr();
            }
        });
}, 5000);

function refreshQr(){
    var img = document.getElementById('qrImg');
    if(img){
        img.src = '/admin/whatsapp/qr.png?t=' + Date.now();
        img.style.display = '';
    }
    document.getElementById('qrError').style.display = 'none';
}
</text>
}
</script>
}
