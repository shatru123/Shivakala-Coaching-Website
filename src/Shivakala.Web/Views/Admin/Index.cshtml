@model AdminDashboardViewModel
@{
    ViewData["Title"] = "Admin Dashboard";
    ViewData["MetaDescription"] = "Admin dashboard for Shivakala Coaching Classes.";
}

<section class="page-hero">
    <div class="container d-flex flex-wrap justify-content-between align-items-center gap-3">
        <div>
            <span class="badge-soft">Admin</span>
            <h1>Admin Dashboard</h1>
            <p>Review recent student registrations and incoming enquiries.</p>
        </div>
        <form asp-action="Logout" method="post">
            @Html.AntiForgeryToken()
            <button type="submit" class="toolbar-btn">Logout</button>
        </form>
    </div>
</section>

<section class="section-shell pt-0">
    <div class="container">
        <div class="row g-4 mb-4">
            <div class="col-md-6">
                <div class="stat-card reveal">
                    <strong>@Model.RegistrationCount</strong>
                    <span>Total Registrations</span>
                </div>
            </div>
            <div class="col-md-6">
                <div class="stat-card reveal">
                    <strong>@Model.EnquiryCount</strong>
                    <span>Total Enquiries</span>
                </div>
            </div>
        </div>

        <div class="row g-4">
            <div class="col-lg-6">
                <div class="glass-card reveal">
                    <div class="d-flex justify-content-between align-items-center mb-3">
                        <h3 class="mb-0">Recent Registrations</h3>
                        <a asp-action="Registrations" class="btn btn-gradient">View All</a>
                    </div>
                    <div class="table-responsive">
                        <table class="table admin-table align-middle">
                            <thead>
                                <tr>
                                    <th>Name</th>
                                    <th>Standard</th>
                                    <th>Mobile</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var item in Model.RecentRegistrations)
                                {
                                    <tr>
                                        <td>@item.FullName</td>
                                        <td>@item.Standard</td>
                                        <td>@item.Mobile</td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>
            <div class="col-lg-6">
                <div class="glass-card reveal">
                    <div class="d-flex justify-content-between align-items-center mb-3">
                        <h3 class="mb-0">Recent Enquiries</h3>
                        <a asp-action="Enquiries" class="btn btn-gradient">View All</a>
                    </div>
                    <div class="table-responsive">
                        <table class="table admin-table align-middle">
                            <thead>
                                <tr>
                                    <th>Name</th>
                                    <th>Mobile</th>
                                    <th>Message</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var item in Model.RecentEnquiries)
                                {
                                    <tr>
                                        <td>@item.Name</td>
                                        <td>@item.Mobile</td>
                                        <td class="text-truncate" style="max-width: 220px;">@item.Message</td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>
