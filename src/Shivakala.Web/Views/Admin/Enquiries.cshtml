@model AdminListPageViewModel<EnquiryAdminViewModel>
@{
    ViewData["Title"] = Model.Title;
    ViewData["MetaDescription"] = "Admin enquiries list.";
}

<section class="page-hero">
    <div class="container d-flex flex-wrap justify-content-between align-items-center gap-3">
        <div>
            <span class="badge-soft">Admin</span>
            <h1>@Model.Title</h1>
            <p>Incoming website enquiries from students and parents.</p>
        </div>
        <a asp-action="Index" class="toolbar-btn">Back to Dashboard</a>
    </div>
</section>

<section class="section-shell pt-0">
    <div class="container">
        <div class="glass-card reveal">
            <div class="table-responsive">
                <table class="table admin-table align-middle">
                    <thead>
                        <tr>
                            <th>Id</th>
                            <th>Name</th>
                            <th>Mobile</th>
                            <th>Message</th>
                            <th>Created</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var item in Model.Items)
                        {
                            <tr>
                                <td>@item.Id</td>
                                <td>@item.Name</td>
                                <td>@item.Mobile</td>
                                <td>@item.Message</td>
                                <td>@item.CreatedDate.ToLocalTime().ToString("dd MMM yyyy hh:mm tt")</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</section>
