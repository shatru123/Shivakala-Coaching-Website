@model Shivakala.Core.ViewModels.AdminListPageViewModel<Shivakala.Core.ViewModels.EnquiryAdminViewModel>
@{ ViewData["Title"] = "Enquiries | Admin"; ViewData["MetaDescription"] = "Admin enquiries."; }

<section class="page-hero" style="background:linear-gradient(135deg,var(--green-dark),var(--navy))">
    <div class="container d-flex justify-content-between align-items-center flex-wrap gap-3">
        <div><span class="badge-soft">Admin</span><h1>Enquiries</h1><p>All website enquiries</p></div>
        <div class="d-flex gap-2">
            <a asp-action="ExportEnquiries" class="toolbar-btn" style="background:var(--green)"><i class="fa-solid fa-download"></i>Export CSV</a>
            <a asp-action="Index" class="toolbar-btn"><i class="fa-solid fa-gauge"></i>Dashboard</a>
        </div>
    </div>
</section>
<section class="section-shell pt-0">
    <div class="container">
        <div class="glass-card mb-3">
            <form method="get" class="row g-2 align-items-end">
                <div class="col-md-5"><input name="search" value="@ViewData["Search"]" class="form-control" placeholder="Search name or mobile..." /></div>
                <div class="col-md-3">
                    <select name="unread" class="form-select">
                        <option value="">All Enquiries</option>
                        <option value="true" selected="@(ViewData["Unread"]?.ToString()=="True")">Unread Only</option>
                    </select>
                </div>
                <div class="col-md-4 d-flex gap-2">
                    <button type="submit" class="btn-primary-sk"><i class="fa-solid fa-filter"></i>Filter</button>
                    <a asp-action="Enquiries" class="btn-outline-sk"><i class="fa-solid fa-rotate-left"></i></a>
                    <span class="ms-auto" style="font-size:0.82rem;color:var(--text-mid);align-self:center">@Model.Items.Count records</span>
                </div>
            </form>
        </div>
        <div class="glass-card">
            <div class="table-responsive">
                <table class="table admin-table align-middle">
                    <thead><tr><th>#</th><th>Name</th><th>Mobile</th><th>Email</th><th>Class</th><th>Message</th><th>Status</th><th>Date</th><th>Action</th></tr></thead>
                    <tbody>
                        @foreach (var e in Model.Items)
                        {
                            <tr style="@(e.IsRead?"":"background:rgba(245,166,35,0.04)")">
                                <td style="color:var(--text-light);font-size:0.78rem">@e.Id</td>
                                <td style="font-weight:@(e.IsRead?"400":"700");color:var(--text)">@e.Name</td>
                                <td>@e.Mobile</td>
                                <td style="font-size:0.82rem;color:var(--text-mid)">@(e.Email??"-")</td>
                                <td style="font-size:0.82rem">@(e.ClassInterested??"-")</td>
                                <td style="max-width:200px;font-size:0.82rem;color:var(--text-mid);overflow:hidden;text-overflow:ellipsis;white-space:nowrap" title="@e.Message">@e.Message</td>
                                <td><span style="font-size:0.7rem;padding:2px 8px;border-radius:99px;font-weight:700;background:@(e.IsRead?"rgba(27,122,62,0.1)":"rgba(245,166,35,0.15)");color:@(e.IsRead?"var(--green)":"var(--orange)")">@(e.IsRead?"Read":"Unread")</span></td>
                                <td style="font-size:0.78rem;white-space:nowrap">@e.CreatedDate.ToLocalTime().ToString("dd MMM yy")</td>
                                <td>
                                    @if (!e.IsRead)
                                    {
                                        <button type="button" class="toolbar-btn" style="font-size:0.7rem;padding:4px 8px;background:var(--green)"
                                            onclick="openReplyModal(@e.Id,'@e.Name','@e.Message.Replace("'","\'").Replace("\n"," ")')">
                                            <i class="fa-solid fa-check-double"></i>
                                        </button>
                                    }
                                    else if (!string.IsNullOrWhiteSpace(e.AdminReply))
                                    { <span style="font-size:0.68rem;color:var(--text-light)">✓ Replied</span> }
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</section>

<!-- Reply Modal -->
<div id="replyModal" style="display:none;position:fixed;inset:0;background:rgba(0,0,0,0.5);z-index:2000;align-items:center;justify-content:center">
    <div class="glass-card" style="width:100%;max-width:480px;margin:20px">
        <h5 style="color:var(--navy);margin-bottom:8px"><i class="fa-solid fa-reply me-2" style="color:var(--green)"></i>Mark as Read</h5>
        <p id="replyName" style="color:var(--text-mid);font-size:0.85rem;margin-bottom:4px"></p>
        <p id="replyMsg" style="color:var(--text);font-size:0.88rem;background:var(--off-white);padding:10px;border-radius:8px;margin-bottom:16px"></p>
        <form asp-action="MarkEnquiryRead" method="post">
            @Html.AntiForgeryToken()
            <input type="hidden" id="replyId" name="id" />
            <div class="mb-3">
                <label class="form-label">Reply / Note (optional)</label>
                <textarea name="reply" class="form-control" rows="3" placeholder="Add a note or reply..."></textarea>
            </div>
            <div class="d-flex gap-2">
                <button type="submit" class="btn-green-sk"><i class="fa-solid fa-check"></i>Mark Read</button>
                <button type="button" onclick="document.getElementById('replyModal').style.display='none'" class="btn-outline-sk">Cancel</button>
            </div>
        </form>
    </div>
</div>
@section Scripts {
<script>
function openReplyModal(id, name, msg) {
    document.getElementById('replyId').value = id;
    document.getElementById('replyName').textContent = 'From: ' + name;
    document.getElementById('replyMsg').textContent = msg;
    document.getElementById('replyModal').style.display = 'flex';
}
</script>
}
