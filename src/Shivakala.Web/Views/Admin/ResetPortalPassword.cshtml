@model Shivakala.Core.ViewModels.AdminResetPasswordViewModel
@{ ViewData["Title"] = "Reset Portal Password"; }

<section class="page-hero" style="background:linear-gradient(135deg,var(--navy-dark),var(--navy-mid))">
    <div class="container d-flex justify-content-between align-items-center flex-wrap gap-3">
        <div>
            <span class="badge-soft"><i class="fa-solid fa-key me-1"></i>Admin</span>
            <h1>Reset Portal Password</h1>
            <p>@Model.Role account for @Model.FullName</p>
        </div>
        <a asp-action="PortalAccounts" class="btn-outline-sk"><i class="fa-solid fa-arrow-left"></i>Back</a>
    </div>
</section>

<section class="section-shell pt-0">
    <div class="container" style="max-width:680px">
        <div class="glass-card">
            <div class="mb-3" style="font-size:.9rem;color:var(--text-mid)">
                <div><strong>Username:</strong> @Model.Username</div>
                <div><strong>Role:</strong> @Model.Role</div>
            </div>
            <form method="post" class="row g-3">
                @Html.AntiForgeryToken()
                <input asp-for="UserId" type="hidden" />
                <input asp-for="Username" type="hidden" />
                <input asp-for="Role" type="hidden" />
                <input asp-for="FullName" type="hidden" />
                <div asp-validation-summary="ModelOnly" class="text-danger small"></div>
                <div class="col-md-6">
                    <label asp-for="NewPassword" class="form-label fw-600"></label>
                    <input asp-for="NewPassword" class="form-control" type="password" autocomplete="new-password" />
                    <span asp-validation-for="NewPassword" class="text-danger small"></span>
                </div>
                <div class="col-md-6">
                    <label asp-for="ConfirmPassword" class="form-label fw-600"></label>
                    <input asp-for="ConfirmPassword" class="form-control" type="password" autocomplete="new-password" />
                    <span asp-validation-for="ConfirmPassword" class="text-danger small"></span>
                </div>
                <div class="col-12 d-flex gap-2">
                    <button type="submit" class="btn-primary-sk"><i class="fa-solid fa-floppy-disk"></i>Save New Password</button>
                    <a asp-action="PortalAccounts" class="btn-outline-sk">Cancel</a>
                </div>
            </form>
        </div>
    </div>
</section>
