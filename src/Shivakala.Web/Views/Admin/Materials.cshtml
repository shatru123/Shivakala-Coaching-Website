@model IReadOnlyList<Shivakala.Core.Entities.StudyMaterial>
@{ ViewData["Title"] = "Study Materials | Admin"; ViewData["MetaDescription"] = "Admin materials."; }
<section class="page-hero" style="background:linear-gradient(135deg,var(--purple),var(--navy))">
    <div class="container d-flex justify-content-between align-items-center flex-wrap gap-3">
        <div><span class="badge-soft">Admin</span><h1>Study Materials</h1><p>Manage question papers, notes and worksheets</p></div>
        <div class="d-flex gap-2">
            <a asp-action="CreateMaterial" class="btn-green-sk"><i class="fa-solid fa-upload"></i>Upload Material</a>
            <a asp-action="Index" class="toolbar-btn"><i class="fa-solid fa-gauge"></i>Dashboard</a>
        </div>
    </div>
</section>
<section class="section-shell pt-0">
    <div class="container">
        <div class="glass-card">
            <div class="table-responsive">
                <table class="table admin-table align-middle">
                    <thead><tr><th>#</th><th>Title</th><th>Standard</th><th>Subject</th><th>Type</th><th>Size</th><th>Active</th><th>Date</th><th></th></tr></thead>
                    <tbody>
                        @foreach (var m in Model)
                        {
                            var sizeStr = m.FileSizeBytes < 1024 ? $"{m.FileSizeBytes}B" : m.FileSizeBytes < 1048576 ? $"{m.FileSizeBytes/1024.0:F1}KB" : $"{m.FileSizeBytes/1048576.0:F1}MB";
                            <tr>
                                <td style="font-size:0.78rem;color:var(--text-light)">@m.Id</td>
                                <td>
                                    <div style="font-weight:600;color:var(--text)">@m.Title</div>
                                    <div style="font-size:0.7rem;color:var(--text-mid)">@m.TitleMarathi</div>
                                </td>
                                <td><span class="badge-soft dark" style="font-size:0.7rem">@m.Standard</span></td>
                                <td style="font-size:0.82rem">@m.Subject</td>
                                <td style="font-size:0.78rem;color:var(--purple);font-weight:600">@m.MaterialType</td>
                                <td style="font-size:0.78rem;color:var(--text-mid)">@sizeStr</td>
                                <td><span style="font-size:0.7rem;font-weight:700;color:@(m.IsActive?"var(--green)":"var(--red)")">@(m.IsActive?"Active":"Hidden")</span></td>
                                <td style="font-size:0.78rem;white-space:nowrap">@m.UploadedDate.ToLocalTime().ToString("dd MMM yy")</td>
                                <td>
                                    <div class="d-flex gap-1">
                                        <a href="@m.FileUrl" target="_blank" class="toolbar-btn" style="font-size:0.7rem;padding:4px 8px;background:var(--green)"><i class="fa-solid fa-eye"></i></a>
                                        <form asp-action="DeleteMaterial" method="post" onsubmit="return confirm('Delete this material?')">
                                            @Html.AntiForgeryToken()
                                            <input type="hidden" name="id" value="@m.Id" />
                                            <button type="submit" class="toolbar-btn" style="font-size:0.7rem;padding:4px 8px;background:var(--red)"><i class="fa-solid fa-trash"></i></button>
                                        </form>
                                    </div>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</section>
