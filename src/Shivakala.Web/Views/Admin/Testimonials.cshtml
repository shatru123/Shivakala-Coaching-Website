@model IReadOnlyList<Shivakala.Core.Entities.Testimonial>
@{ ViewData["Title"] = "Testimonials | Admin"; ViewData["MetaDescription"] = "Admin testimonials."; }
<section class="page-hero" style="background:linear-gradient(135deg,var(--gold),var(--orange))">
    <div class="container d-flex justify-content-between align-items-center flex-wrap gap-3">
        <div><span class="badge-soft">Admin</span><h1>Testimonials</h1><p>Approve and manage reviews</p></div>
        <div class="d-flex gap-2">
            <a asp-action="CreateTestimonial" class="btn-green-sk"><i class="fa-solid fa-plus"></i>New Testimonial</a>
            <a asp-action="Index" class="toolbar-btn"><i class="fa-solid fa-gauge"></i>Dashboard</a>
        </div>
    </div>
</section>
<section class="section-shell pt-0">
    <div class="container">
        <div class="glass-card mb-3" style="border-left:4px solid var(--navy)">
            <div class="d-flex justify-content-between align-items-center flex-wrap gap-2">
                <div>
                    <div style="font-weight:700;color:var(--navy)">Homepage usage</div>
                    <div style="font-size:0.85rem;color:var(--text-mid)">Approved and featured testimonials appear on the home page. If no testimonials are featured, approved testimonials are used as a fallback.</div>
                </div>
                <a asp-action="HomePageContent" class="toolbar-btn">
                    <i class="fa-solid fa-house"></i>Homepage Settings
                </a>
            </div>
        </div>
        <div class="row g-3">
            @foreach (var t in Model)
            {
                <div class="col-md-6">
                    <div class="glass-card" style="border-left:4px solid @(t.IsApproved?"var(--green)":"var(--gold)")">
                        <div class="d-flex justify-content-between align-items-start gap-2 mb-2">
                            <div>
                                <div style="font-weight:700;color:var(--navy)">@t.Name</div>
                                <div style="font-size:0.78rem;color:var(--green)">@t.Role</div>
                            </div>
                            <div class="d-flex flex-column align-items-end gap-1">
                                <span style="font-size:0.7rem;font-weight:700;color:@(t.IsApproved?"var(--green)":"var(--orange)")">@(t.IsApproved?"✓ Approved":"⏳ Pending")</span>
                                @if (t.IsFeatured) { <span style="font-size:0.68rem;color:var(--gold);font-weight:700">⭐ Featured</span> }
                            </div>
                        </div>
                        <p style="font-size:0.87rem;color:var(--text-mid);font-style:italic;margin-bottom:12px">"@t.Quote"</p>
                        <div style="color:var(--gold);font-size:0.82rem;margin-bottom:12px">@string.Concat(Enumerable.Repeat("★", t.Rating))</div>
                        <div class="d-flex gap-2 flex-wrap">
                            <a asp-action="EditTestimonial" asp-route-id="@t.Id" class="toolbar-btn" style="font-size:0.75rem"><i class="fa-solid fa-pen"></i>Edit</a>
                            @if (!t.IsApproved)
                            {
                                <form asp-action="ApproveTestimonial" method="post" class="d-inline">
                                    @Html.AntiForgeryToken()
                                    <input type="hidden" name="id" value="@t.Id" />
                                    <input type="hidden" name="featured" value="false" />
                                    <button type="submit" class="toolbar-btn" style="background:var(--green);font-size:0.75rem"><i class="fa-solid fa-check"></i>Approve</button>
                                </form>
                                <form asp-action="ApproveTestimonial" method="post" class="d-inline">
                                    @Html.AntiForgeryToken()
                                    <input type="hidden" name="id" value="@t.Id" />
                                    <input type="hidden" name="featured" value="true" />
                                    <button type="submit" class="toolbar-btn" style="background:var(--gold);color:var(--navy);font-size:0.75rem"><i class="fa-solid fa-star"></i>Approve + Feature</button>
                                </form>
                            }
                            <form asp-action="DeleteTestimonial" method="post" onsubmit="return confirm('Delete?')">
                                @Html.AntiForgeryToken()
                                <input type="hidden" name="id" value="@t.Id" />
                                <button type="submit" class="toolbar-btn" style="background:var(--red);font-size:0.75rem"><i class="fa-solid fa-trash"></i></button>
                            </form>
                        </div>
                    </div>
                </div>
            }
        </div>
    </div>
</section>
