@model AdminListPageViewModel<StudentAdminViewModel>
@{
    ViewData["Title"] = Model.Title;
    ViewData["MetaDescription"] = "Admin registrations list.";
}

<section class="page-hero">
    <div class="container d-flex flex-wrap justify-content-between align-items-center gap-3">
        <div>
            <span class="badge-soft">Admin</span>
            <h1>@Model.Title</h1>
            <p>Submitted admission forms from the website.</p>
        </div>
        <a asp-action="Index" class="toolbar-btn">Back to Dashboard</a>
    </div>
</section>

<section class="section-shell pt-0">
    <div class="container">
        <div class="glass-card reveal">
            <div class="table-responsive">
                <table class="table admin-table align-middle">
                    <thead>
                        <tr>
                            <th>Id</th>
                            <th>Name</th>
                            <th>Mobile</th>
                            <th>Email</th>
                            <th>Standard</th>
                            <th>Subject</th>
                            <th>Address</th>
                            <th>Created</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var item in Model.Items)
                        {
                            <tr>
                                <td>@item.Id</td>
                                <td>@item.FullName</td>
                                <td>@item.Mobile</td>
                                <td>@(string.IsNullOrWhiteSpace(item.Email) ? "-" : item.Email)</td>
                                <td>@item.Standard</td>
                                <td>@item.Subject</td>
                                <td>@item.Address</td>
                                <td>@item.CreatedDate.ToLocalTime().ToString("dd MMM yyyy hh:mm tt")</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</section>
