@model Shivakala.Core.ViewModels.AdminListPageViewModel<Shivakala.Core.ViewModels.StudentAdminViewModel>
@{ ViewData["Title"] = "Registrations | Admin"; ViewData["MetaDescription"] = "Admin registrations."; }

<section class="page-hero">
    <div class="container d-flex justify-content-between align-items-center flex-wrap gap-3">
        <div><span class="badge-soft">Admin</span><h1>Registrations</h1><p>All submitted admission forms</p></div>
        <div class="d-flex gap-2">
            <a asp-action="CreateStudent" class="btn-green-sk"><i class="fa-solid fa-user-plus"></i>Add Student</a>
            <a asp-action="ExportRegistrations" class="toolbar-btn" style="background:var(--green)"><i class="fa-solid fa-download"></i>Export CSV</a>
            <a asp-action="Index" class="toolbar-btn"><i class="fa-solid fa-gauge"></i>Dashboard</a>
        </div>
    </div>
</section>
<section class="section-shell pt-0">
    <div class="container">
        <!-- Filter bar -->
        <div class="glass-card mb-3">
            <form method="get" class="row g-2 align-items-end">
                <div class="col-md-4">
                    <input name="search" value="@ViewData["Search"]" class="form-control" placeholder="Search name or mobile..." />
                </div>
                <div class="col-md-3">
                    <select name="status" class="form-select">
                        <option value="">All Status</option>
                        @foreach (var s in new[]{"Pending","Admitted","Rejected","Waitlisted"})
                        { <option value="@s" selected="@(ViewData["Status"]?.ToString()==s)">@s</option> }
                    </select>
                </div>
                <div class="col-md-5 d-flex gap-2">
                    <button type="submit" class="btn-primary-sk"><i class="fa-solid fa-filter"></i>Filter</button>
                    <a asp-action="Registrations" class="btn-outline-sk"><i class="fa-solid fa-rotate-left"></i>Reset</a>
                    <span class="ms-auto" style="font-size:0.82rem;color:var(--text-mid);align-self:center">@Model.Items.Count records</span>
                </div>
            </form>
        </div>

        <div class="glass-card">
            <div class="table-responsive">
                <table class="table admin-table align-middle">
                    <thead><tr><th>#</th><th>Student</th><th>Parent</th><th>Mobile</th><th>Standard</th><th>Subject</th><th>Board</th><th>Status</th><th>Date</th><th>Action</th></tr></thead>
                    <tbody>
                        @foreach (var r in Model.Items)
                        {
                            <tr>
                                <td style="color:var(--text-light);font-size:0.78rem">@r.Id</td>
                                <td>
                                    <div style="font-weight:600;color:var(--text)">@r.FullName</div>
                                    @if (!string.IsNullOrWhiteSpace(r.AdmissionNumber)) { <div style="font-size:0.72rem;color:var(--text-mid)">ID: @r.AdmissionNumber</div> }
                                    @if (!string.IsNullOrWhiteSpace(r.Email)) { <div style="font-size:0.72rem;color:var(--text-mid)">@r.Email</div> }
                                </td>
                                <td style="font-size:0.85rem;color:var(--text-mid)">@(r.ParentName??"-")</td>
                                <td>@r.Mobile</td>
                                <td><span class="badge-soft dark">@r.Standard</span></td>
                                <td style="font-size:0.82rem">@r.Subject</td>
                                <td style="font-size:0.82rem">@(r.Board??"-")</td>
                                <td>
                                    <span style="font-size:0.72rem;padding:3px 10px;border-radius:99px;font-weight:700;
                                        background:@(r.Status=="Admitted"?"rgba(27,122,62,0.15)":r.Status=="Pending"?"rgba(245,166,35,0.15)":r.Status=="Waitlisted"?"rgba(27,43,107,0.12)":"rgba(192,57,43,0.15)");
                                        color:@(r.Status=="Admitted"?"var(--green)":r.Status=="Pending"?"var(--orange)":r.Status=="Waitlisted"?"var(--navy)":"var(--red)")">
                                        @r.Status
                                    </span>
                                </td>
                                <td style="font-size:0.78rem;white-space:nowrap">@r.CreatedDate.ToLocalTime().ToString("dd MMM yy")</td>
                                <td>
                                    <div class="d-flex gap-1">
                                        <a asp-action="StudentIdCard" asp-route-id="@r.Id" class="toolbar-btn" style="font-size:0.7rem;padding:4px 8px;background:var(--green)">
                                            <i class="fa-solid fa-id-card"></i>
                                        </a>
                                        <button type="button" class="toolbar-btn" style="font-size:0.7rem;padding:4px 8px;background:var(--navy-mid)"
                                            onclick="openStatusModal(@r.Id,'@r.FullName','@r.Status')">
                                            <i class="fa-solid fa-pen"></i>
                                        </button>
                                    </div>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</section>

<!-- Status Modal -->
<div id="statusModal" style="display:none;position:fixed;inset:0;background:rgba(0,0,0,0.5);z-index:2000;align-items:center;justify-content:center">
    <div class="glass-card" style="width:100%;max-width:440px;margin:20px">
        <h5 style="color:var(--navy);margin-bottom:16px"><i class="fa-solid fa-pen me-2"></i>Update Status</h5>
        <p id="modalStudent" style="color:var(--text-mid);font-size:0.88rem;margin-bottom:16px"></p>
        <form asp-action="UpdateStudentStatus" method="post">
            @Html.AntiForgeryToken()
            <input type="hidden" id="modalId" name="id" value="" />
            <div class="mb-3">
                <label class="form-label">Status</label>
                <select id="modalStatus" name="status" class="form-select">
                    @foreach (var s in new[]{"Pending","Admitted","Rejected","Waitlisted"})
                    { <option value="@s">@s</option> }
                </select>
            </div>
            <div class="mb-3">
                <label class="form-label">Admin Notes (optional)</label>
                <textarea name="notes" class="form-control" rows="2" placeholder="Internal notes..."></textarea>
            </div>
            <div class="d-flex gap-2">
                <button type="submit" class="btn-primary-sk">Save</button>
                <button type="button" onclick="closeModal()" class="btn-outline-sk">Cancel</button>
            </div>
        </form>
    </div>
</div>

@section Scripts {
<script>
function openStatusModal(id, name, status) {
    document.getElementById('modalId').value = id;
    document.getElementById('modalStudent').textContent = 'Student: ' + name;
    document.getElementById('modalStatus').value = status;
    document.getElementById('statusModal').style.display = 'flex';
}
function closeModal() { document.getElementById('statusModal').style.display = 'none'; }
</script>
}
