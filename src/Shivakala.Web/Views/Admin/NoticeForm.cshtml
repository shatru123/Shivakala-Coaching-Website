@model Shivakala.Core.ViewModels.NoticeFormViewModel
@{ ViewData["Title"] = (Model.Id == 0 ? "Create" : "Edit") + " Notice | Admin"; ViewData["MetaDescription"] = "Admin notice form.";
   bool isEdit = Model.Id != 0; }
<section class="page-hero">
    <div class="container">
        <span class="badge-soft">Admin</span>
        <h1>@(isEdit ? "Edit Notice" : "Create Notice")</h1>
    </div>
</section>
<section class="section-shell pt-0">
    <div class="container" style="max-width:760px">
        <div class="glass-card">
            <form asp-action="@(isEdit?"EditNotice":"CreateNotice")" method="post">
                @Html.AntiForgeryToken()
                @if (isEdit) { <input type="hidden" asp-for="Id" /> }
                <div class="row g-3">
                    <div class="col-md-8">
                        <label class="form-label">Title (English) *</label>
                        <input asp-for="Title" class="form-control" required />
                    </div>
                    <div class="col-md-4">
                        <label class="form-label">Category</label>
                        <select asp-for="Category" class="form-select">
                            @foreach (var c in new[]{"General","Exam","Holiday","Result","Admission"})
                            { <option value="@c">@c</option> }
                        </select>
                    </div>
                    <div class="col-12">
                        <label class="form-label">Title (मराठी) *</label>
                        <input asp-for="TitleMarathi" class="form-control" required />
                    </div>
                    <div class="col-12">
                        <label class="form-label">Body (English) *</label>
                        <textarea asp-for="Body" class="form-control" rows="4" required></textarea>
                    </div>
                    <div class="col-12">
                        <label class="form-label">Body (मराठी) *</label>
                        <textarea asp-for="BodyMarathi" class="form-control" rows="4" required></textarea>
                    </div>
                    <div class="col-md-4">
                        <label class="form-label">Published Date</label>
                        <input asp-for="PublishedDate" type="date" class="form-control" />
                    </div>
                    <div class="col-md-4 d-flex align-items-end gap-3">
                        <div class="form-check">
                            <input asp-for="IsPinned" type="checkbox" class="form-check-input" id="pinned" />
                            <label class="form-check-label" for="pinned">📌 Pinned</label>
                        </div>
                        <div class="form-check">
                            <input asp-for="IsActive" type="checkbox" class="form-check-input" id="active" />
                            <label class="form-check-label" for="active">Active</label>
                        </div>
                    </div>
                    <div class="col-12 d-flex gap-2 pt-2">
                        <button type="submit" class="btn-primary-sk"><i class="fa-solid fa-save"></i>@(isEdit?"Update":"Create")</button>
                        <a asp-action="Notices" class="btn-outline-sk">Cancel</a>
                    </div>
                </div>
            </form>
        </div>
    </div>
</section>
