@model Shivakala.Core.ViewModels.ChangePasswordViewModel
@{ ViewData["Title"] = "Change Password"; }

<section class="page-hero" style="background:linear-gradient(135deg,var(--navy-dark),var(--navy-mid))">
    <div class="container d-flex justify-content-between align-items-center flex-wrap gap-3">
        <div>
            <span class="badge-soft"><i class="fa-solid fa-lock me-1"></i>Admin</span>
            <h1>Change Password</h1>
            <p>Update your admin login password.</p>
        </div>
        <a asp-action="Index" class="btn-outline-sk"><i class="fa-solid fa-gauge"></i>Dashboard</a>
    </div>
</section>

<section class="section-shell pt-0">
    <div class="container" style="max-width:620px">
        <div class="glass-card">
            <form method="post" class="row g-3">
                @Html.AntiForgeryToken()
                <div asp-validation-summary="ModelOnly" class="text-danger small"></div>
                <div class="col-12">
                    <label asp-for="CurrentPassword" class="form-label fw-600"></label>
                    <input asp-for="CurrentPassword" class="form-control" type="password" autocomplete="current-password" />
                    <span asp-validation-for="CurrentPassword" class="text-danger small"></span>
                </div>
                <div class="col-md-6">
                    <label asp-for="NewPassword" class="form-label fw-600"></label>
                    <input asp-for="NewPassword" class="form-control" type="password" autocomplete="new-password" />
                    <span asp-validation-for="NewPassword" class="text-danger small"></span>
                </div>
                <div class="col-md-6">
                    <label asp-for="ConfirmPassword" class="form-label fw-600"></label>
                    <input asp-for="ConfirmPassword" class="form-control" type="password" autocomplete="new-password" />
                    <span asp-validation-for="ConfirmPassword" class="text-danger small"></span>
                </div>
                <div class="col-12 d-flex gap-2">
                    <button type="submit" class="btn-primary-sk"><i class="fa-solid fa-floppy-disk"></i>Update Password</button>
                    <a asp-action="Index" class="btn-outline-sk">Cancel</a>
                </div>
            </form>
        </div>
    </div>
</section>
