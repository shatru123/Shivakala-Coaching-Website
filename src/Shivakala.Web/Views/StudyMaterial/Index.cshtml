@model Shivakala.Core.ViewModels.StudyMaterialsPageViewModel
@using System.Globalization
@{
    ViewData["Title"] = Model.Seo.Title;
    var isMr = CultureInfo.CurrentUICulture.TwoLetterISOLanguageName == "mr";
    string TypeIcon(string t) => t switch { "QuestionPaper"=>"fa-file-lines","AnswerSheet"=>"fa-file-pen","Notes"=>"fa-book","Worksheet"=>"fa-pencil",_=>"fa-file" };
    string TypeColor(string t) => t switch { "QuestionPaper"=>"var(--navy)","AnswerSheet"=>"var(--green)","Notes"=>"var(--gold)","Worksheet"=>"var(--purple)",_=>"var(--text-mid)" };
    string TypeLabel(string t) => isMr ? t switch { "QuestionPaper"=>"प्रश्नपत्रिका","AnswerSheet"=>"उत्तरपत्रिका","Notes"=>"नोट्स","Worksheet"=>"वर्कशीट",_=>t } : t switch { "QuestionPaper"=>"Question Paper","AnswerSheet"=>"Answer Sheet","Notes"=>"Notes","Worksheet"=>"Worksheet",_=>t };
    var standards = new[]{"KG1","KG2","1st","2nd","3rd","4th","5th","6th","7th","8th","9th","10th"};
    var subjects = isMr ? new[]{"गणित","इंग्रजी","विज्ञान"} : new[]{"Mathematics","English","Science"};
    var types = new[]{"QuestionPaper","AnswerSheet","Notes","Worksheet"};
}
<section class="page-hero" style="background:linear-gradient(135deg,var(--purple),var(--navy))">
    <div class="container">
        <span class="badge-soft"><i class="fa-solid fa-folder-open me-1"></i>@(isMr ? "अभ्यास साहित्य" : "Study Materials")</span>
        <h1>@(isMr ? "प्रश्नपत्रिका व अभ्यास साहित्य" : "Question Papers & Study Materials")</h1>
        <p>@(isMr ? "डाउनलोड करा — विनामूल्य" : "Download for free — All standards & subjects")</p>
    </div>
</section>
<section class="section-shell warm-section">
    <div class="container">
        <!-- Filters -->
        <div class="glass-card mb-4">
            <form method="get" class="row g-3 align-items-end">
                <div class="col-md-3">
                    <label class="form-label fw-600" style="font-size:0.82rem">@(isMr ? "इयत्ता" : "Standard")</label>
                    <select name="standard" class="form-select">
                        <option value="">@(isMr?"सर्व":"All Standards")</option>
                        @foreach (var s in standards) { <option value="@s" selected="@(Model.SelectedStandard==s)">@s</option> }
                    </select>
                </div>
                <div class="col-md-3">
                    <label class="form-label fw-600" style="font-size:0.82rem">@(isMr ? "विषय" : "Subject")</label>
                    <select name="subject" class="form-select">
                        <option value="">@(isMr?"सर्व":"All Subjects")</option>
                        @foreach (var s in subjects) { <option value="@s" selected="@(Model.SelectedSubject==s)">@s</option> }
                    </select>
                </div>
                <div class="col-md-3">
                    <label class="form-label fw-600" style="font-size:0.82rem">@(isMr ? "प्रकार" : "Type")</label>
                    <select name="type" class="form-select">
                        <option value="">@(isMr?"सर्व":"All Types")</option>
                        @foreach (var t in types) { <option value="@t" selected="@(Model.SelectedType==t)">@TypeLabel(t)</option> }
                    </select>
                </div>
                <div class="col-md-3 d-flex gap-2">
                    <button type="submit" class="btn-primary-sk flex-fill justify-content-center"><i class="fa-solid fa-filter"></i>@(isMr?"फिल्टर":"Filter")</button>
                    <a asp-action="Index" class="btn-outline-sk"><i class="fa-solid fa-rotate-left"></i></a>
                </div>
            </form>
        </div>

        @if (!Model.Materials.Any())
        {
            <div class="text-center py-5"><i class="fa-solid fa-folder-open fa-3x mb-3" style="color:var(--border)"></i><p class="text-muted">@(isMr ? "सध्या कोणतेही साहित्य उपलब्ध नाही." : "No materials uploaded yet. Check back soon!")</p></div>
        }
        else
        {
            <div class="row g-3">
                @foreach (var m in Model.Materials)
                {
                    <div class="col-md-6 col-lg-4">
                        <div class="glass-card reveal" style="border-top:4px solid @TypeColor(m.MaterialType)">
                            <div class="d-flex align-items-start gap-3">
                                <div style="width:46px;height:46px;border-radius:10px;background:@TypeColor(m.MaterialType);display:flex;align-items:center;justify-content:center;color:#fff;font-size:1.2rem;flex-shrink:0">
                                    <i class="fa-solid @TypeIcon(m.MaterialType)"></i>
                                </div>
                                <div style="flex:1;min-width:0">
                                    <h3 style="font-size:0.95rem;color:var(--navy);margin:0 0 4px;line-height:1.3">@(isMr ? m.TitleMarathi : m.Title)</h3>
                                    <div class="d-flex flex-wrap gap-1 mt-1">
                                        <span style="font-size:0.68rem;padding:2px 8px;border-radius:99px;background:rgba(27,43,107,0.08);color:var(--navy);font-weight:600">@m.Standard</span>
                                        <span style="font-size:0.68rem;padding:2px 8px;border-radius:99px;background:rgba(27,122,62,0.08);color:var(--green);font-weight:600">@m.Subject</span>
                                        <span style="font-size:0.68rem;padding:2px 8px;border-radius:99px;background:rgba(0,0,0,0.05);color:var(--text-mid);font-weight:600">@TypeLabel(m.MaterialType)</span>
                                    </div>
                                </div>
                            </div>
                            <div class="d-flex justify-content-between align-items-center mt-3 pt-2" style="border-top:1px solid var(--border)">
                                <div>
                                    <div style="font-size:0.72rem;color:var(--text-light)"><i class="fa-regular fa-calendar me-1"></i>@m.UploadedDate.ToLocalTime().ToString("dd MMM yyyy")</div>
                                    <div style="font-size:0.72rem;color:var(--text-light)"><i class="fa-solid fa-file me-1"></i>@m.FileSizeDisplay</div>
                                </div>
                                <a href="@m.FileUrl" download class="btn-primary-sk" style="padding:8px 16px;font-size:0.8rem;border-radius:8px">
                                    <i class="fa-solid fa-download"></i>@(isMr?"डाउनलोड":"Download")
                                </a>
                            </div>
                        </div>
                    </div>
                }
            </div>
        }
    </div>
</section>
