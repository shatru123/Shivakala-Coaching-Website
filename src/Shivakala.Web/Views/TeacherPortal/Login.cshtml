@{
    ViewData["Title"] = "Teacher Login | SK Classes";
    Layout = "_Layout";
}

<section style="min-height:70vh;display:flex;align-items:center;background:linear-gradient(135deg,#0d3b2e,#1a6b3a)">
    <div class="container">
        <div class="row justify-content-center">
            <div class="col-md-5 col-lg-4">
                <div style="background:#fff;border-radius:20px;padding:40px;box-shadow:0 20px 60px rgba(0,0,0,.25)">

                    <div class="text-center mb-4">
                        <div style="width:64px;height:64px;background:linear-gradient(135deg,#1a6b3a,#128c7e);border-radius:16px;display:flex;align-items:center;justify-content:center;font-size:1.8rem;margin:0 auto 16px">
                            🧑‍🏫
                        </div>
                        <h4 style="font-weight:800;color:#0d3b2e;margin-bottom:4px">Teacher Portal</h4>
                        <p style="color:#666;font-size:.85rem">Shivakala Coaching Classes</p>
                    </div>

                    @if (!ViewData.ModelState.IsValid)
                    {
                        <div class="alert alert-danger py-2 small" role="alert">
                            <i class="fa-solid fa-triangle-exclamation me-1"></i>
                            Invalid username or password.
                        </div>
                    }

                    <form action="/teacher/login" method="post">
                        @Html.AntiForgeryToken()
                        @if (!string.IsNullOrWhiteSpace(ViewBag.ReturnUrl as string))
                        {
                            <input type="hidden" name="returnUrl" value="@ViewBag.ReturnUrl" />
                        }
                        <div class="mb-3">
                            <label class="form-label" style="font-weight:600;color:#333;font-size:.85rem">Username / Employee Code / Mobile</label>
                            <div class="input-group">
                                <span class="input-group-text" style="background:#f0f7f4;border-color:#c8e6c9">
                                    <i class="fa-solid fa-user" style="color:#1a6b3a;font-size:.85rem"></i>
                                </span>
                                <input type="text" name="username" class="form-control"
                                       placeholder="e.g. employee code or mobile" required autocomplete="username"
                                       style="border-color:#c8e6c9" />
                            </div>
                        </div>
                        <div class="mb-4">
                            <label class="form-label" style="font-weight:600;color:#333;font-size:.85rem">Password</label>
                            <div class="input-group">
                                <span class="input-group-text" style="background:#f0f7f4;border-color:#c8e6c9">
                                    <i class="fa-solid fa-lock" style="color:#1a6b3a;font-size:.85rem"></i>
                                </span>
                                <input type="password" name="password" class="form-control"
                                       placeholder="Your password" required autocomplete="current-password"
                                       style="border-color:#c8e6c9" />
                            </div>
                        </div>
                        <button type="submit" class="btn w-100"
                                style="background:linear-gradient(135deg,#1a6b3a,#128c7e);color:#fff;font-weight:700;padding:12px;border-radius:10px;font-size:.92rem">
                            <i class="fa-solid fa-right-to-bracket me-2"></i>Login to Portal
                        </button>
                        <p class="form-text text-center mt-2 mb-0" style="font-size:.72rem">
                            Use your <strong>employee code</strong> or <strong>mobile number</strong> as username.<br />
                            Default password = <strong>last 4 digits</strong> of your registered mobile.
                        </p>
                    </form>

                    <div class="text-center mt-4 pt-3" style="border-top:1px solid #f0f0f0">
                        <div style="display:flex;gap:12px;justify-content:center">
                            <a asp-controller="Admin" asp-action="Login"
                               style="font-size:.75rem;color:#666;text-decoration:none">
                                <i class="fa-solid fa-shield-halved me-1"></i>Admin Login
                            </a>
                            <span style="color:#ddd">|</span>
                            <a asp-controller="ParentPortal" asp-action="Login"
                               style="font-size:.75rem;color:#666;text-decoration:none">
                                <i class="fa-solid fa-user-group me-1"></i>Parent Login
                            </a>
                            <span style="color:#ddd">|</span>
                            <a asp-controller="Home" asp-action="Index"
                               style="font-size:.75rem;color:#666;text-decoration:none">
                                <i class="fa-solid fa-house me-1"></i>Home
                            </a>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>
