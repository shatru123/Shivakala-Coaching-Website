@model Shivakala.Core.Entities.Exam
@{ ViewData["Title"] = "Schedule Exam | Admin"; }

<section class="page-hero" style="background:linear-gradient(135deg,var(--navy-dark),var(--navy-mid))">
    <div class="container"><span class="badge-soft">Admin</span><h1>Schedule Exam</h1></div>
</section>

<section class="section-shell pt-0">
    <div class="container" style="max-width:640px">
        <div class="glass-card">
            <form asp-action="Create" method="post">
                @Html.AntiForgeryToken()
                <div asp-validation-summary="ModelOnly" class="alert alert-danger"></div>
                <div class="row g-3">
                    <div class="col-12">
                        <label class="form-label fw-600">Exam Title *</label>
                        <input asp-for="Title" class="form-control" placeholder="e.g. Unit Test 1 – Mathematics" required />
                    </div>
                    <div class="col-md-6">
                        <label class="form-label fw-600">Standard *</label>
                        <input asp-for="Standard" class="form-control" placeholder="8th" required />
                    </div>
                    <div class="col-md-6">
                        <label class="form-label fw-600">Subject *</label>
                        <input asp-for="Subject" class="form-control" placeholder="Mathematics" required />
                    </div>
                    <div class="col-md-6">
                        <label class="form-label fw-600">Exam Type</label>
                        <select asp-for="ExamType" class="form-select">
                            @foreach (var t in new[]{"Weekly","Monthly","Half-Yearly","Annual","Practice"})
                            { <option value="@t">@t</option> }
                        </select>
                    </div>
                    <div class="col-md-6">
                        <label class="form-label fw-600">Batch (optional)</label>
                        <select asp-for="BatchId" class="form-select">
                            <option value="">— All Batches —</option>
                            @foreach (var b in (IReadOnlyList<Shivakala.Core.Entities.Batch>)ViewBag.Batches)
                            { <option value="@b.Id">@b.Name</option> }
                        </select>
                    </div>
                    <div class="col-md-4">
                        <label class="form-label fw-600">Total Marks</label>
                        <input asp-for="TotalMarks" type="number" class="form-control" />
                    </div>
                    <div class="col-md-4">
                        <label class="form-label fw-600">Passing Marks</label>
                        <input asp-for="PassingMarks" type="number" class="form-control" />
                    </div>
                    <div class="col-md-4">
                        <label class="form-label fw-600">Duration</label>
                        <input asp-for="Duration" class="form-control" placeholder="2 hrs" />
                    </div>
                    <div class="col-md-6">
                        <label class="form-label fw-600">Exam Date *</label>
                        <input asp-for="ExamDate" type="datetime-local" class="form-control" required />
                    </div>
                </div>
                <div class="d-flex gap-2 mt-4">
                    <button type="submit" class="btn-primary-sk"><i class="fa-solid fa-calendar-plus"></i>Schedule</button>
                    <a asp-action="Index" class="btn-outline-sk">Cancel</a>
                </div>
            </form>
        </div>
    </div>
</section>
