@model Shivakala.Core.ViewModels.GalleryPageViewModel
@using System.Globalization
@{
    ViewData["Title"] = Model.Seo.Title;
    var isMr = CultureInfo.CurrentUICulture.TwoLetterISOLanguageName == "mr";
}
<section class="page-hero" style="background:linear-gradient(135deg,var(--teal),var(--green-dark))">
    <div class="container">
        <span class="badge-soft"><i class="fa-solid fa-images me-1"></i>@(isMr ? "गॅलरी" : "Gallery")</span>
        <h1>@(isMr ? "फोटो गॅलरी" : "Photo Gallery")</h1>
        <p>@(isMr ? "शिवकला क्लासेसमधील क्षण" : "Moments from Shivakala Coaching Classes")</p>
    </div>
</section>
<section class="section-shell warm-section">
    <div class="container">
        <!-- Category filter -->
        @if (Model.Categories.Any())
        {
            <div class="d-flex flex-wrap gap-2 mb-4">
                <a asp-action="Index" class="@(string.IsNullOrEmpty(Model.SelectedCategory) ? "btn-primary-sk" : "btn-outline-sk")" style="padding:7px 16px;font-size:0.8rem;border-radius:20px">
                    @(isMr ? "सर्व" : "All")
                </a>
                @foreach (var cat in Model.Categories)
                {
                    <a asp-action="Index" asp-route-category="@cat"
                       class="@(Model.SelectedCategory == cat ? "btn-primary-sk" : "btn-outline-sk")" style="padding:7px 16px;font-size:0.8rem;border-radius:20px">
                        @cat
                    </a>
                }
            </div>
        }

        @if (!Model.Items.Any())
        {
            <div class="text-center py-5">
                <i class="fa-solid fa-images fa-3x mb-3" style="color:var(--border)"></i>
                <p class="text-muted">@(isMr ? "सध्या कोणतेही फोटो नाहीत." : "No gallery items yet. Check back soon!")</p>
            </div>
        }
        else
        {
            <div class="row g-3" id="galleryGrid">
                @foreach (var item in Model.Items)
                {
                    <div class="col-6 col-md-4 col-lg-3">
                        <div class="gallery-item reveal" onclick="openLightbox('@item.ImageUrl','@item.Title','@item.Caption')">
                            <div style="position:relative;overflow:hidden;border-radius:12px;aspect-ratio:4/3;background:var(--light-gray);cursor:pointer;box-shadow:var(--shadow-sm);transition:all 0.25s ease"
                                 onmouseenter="this.style.transform='scale(1.03)';this.style.boxShadow='var(--shadow-md)'"
                                 onmouseleave="this.style.transform='';this.style.boxShadow='var(--shadow-sm)'">
                                <img src="@item.ImageUrl" alt="@item.Title" loading="lazy"
                                     style="width:100%;height:100%;object-fit:cover;display:block"
                                     onerror="this.src='/img/placeholder-gallery.svg'" />
                                <div style="position:absolute;inset:0;background:linear-gradient(to top,rgba(27,43,107,0.7),transparent);opacity:0;transition:opacity 0.25s ease;display:flex;align-items:flex-end;padding:12px"
                                     onmouseenter="this.style.opacity='1'" onmouseleave="this.style.opacity='0'">
                                    <div>
                                        <div style="color:#fff;font-size:0.82rem;font-weight:700">@item.Title</div>
                                        @if (!string.IsNullOrWhiteSpace(item.Caption))
                                        { <div style="color:rgba(255,255,255,0.8);font-size:0.72rem">@item.Caption</div> }
                                    </div>
                                </div>
                                <div style="position:absolute;top:8px;right:8px;background:rgba(255,255,255,0.9);border-radius:50%;width:28px;height:28px;display:flex;align-items:center;justify-content:center;font-size:0.7rem;color:var(--navy)">
                                    <i class="fa-solid fa-expand"></i>
                                </div>
                            </div>
                        </div>
                    </div>
                }
            </div>
        }
    </div>
</section>

<!-- Lightbox -->
<div id="lightbox" style="display:none;position:fixed;inset:0;background:rgba(0,0,0,0.92);z-index:9999;align-items:center;justify-content:center;flex-direction:column"
     onclick="closeLightbox()">
    <button onclick="closeLightbox()" style="position:absolute;top:20px;right:24px;background:rgba(255,255,255,0.2);border:none;color:#fff;width:44px;height:44px;border-radius:50%;font-size:1.2rem;cursor:pointer;display:flex;align-items:center;justify-content:center">
        <i class="fa-solid fa-xmark"></i>
    </button>
    <img id="lightboxImg" src="" alt="" style="max-width:90vw;max-height:80vh;object-fit:contain;border-radius:8px;box-shadow:0 8px 40px rgba(0,0,0,0.5)" onclick="event.stopPropagation()" />
    <div id="lightboxCaption" style="color:rgba(255,255,255,0.85);font-size:0.9rem;margin-top:14px;text-align:center;max-width:600px;padding:0 20px"></div>
</div>

@section Scripts {
<script>
function openLightbox(url, title, caption) {
    document.getElementById('lightboxImg').src = url;
    document.getElementById('lightboxImg').alt = title;
    document.getElementById('lightboxCaption').textContent = caption || title;
    const lb = document.getElementById('lightbox');
    lb.style.display = 'flex';
    document.body.style.overflow = 'hidden';
}
function closeLightbox() {
    document.getElementById('lightbox').style.display = 'none';
    document.body.style.overflow = '';
}
document.addEventListener('keydown', e => { if (e.key === 'Escape') closeLightbox(); });
</script>
}
