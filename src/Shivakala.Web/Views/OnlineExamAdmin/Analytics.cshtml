@model Shivakala.Core.ViewModels.OnlineExamAnalyticsViewModel
@{
    Layout = "_AdminLayout";
    ViewData["Title"] = "Exam Analytics - " + Model.ExamTitle;
    var avgTime = TimeSpan.FromSeconds(Model.AverageTimeTakenSeconds);
}

<div class="p-4">
    <div class="d-flex flex-wrap justify-content-between align-items-center mb-4 gap-3">
        <div>
            <span class="badge-soft dark mb-1"><i class="fa-solid fa-chart-line me-1"></i>Performance Analytics &amp; Rankings</span>
            <h2 class="fw-bold mb-1" style="color:var(--navy-dark)">@Model.ExamTitle</h2>
            <p class="text-muted mb-0 small">@Model.Subject &bull; Standard @Model.Standard &bull; Comprehensive metrics, topic breakdown and question accuracy insights</p>
        </div>
        <div class="d-flex gap-2">
            <a asp-action="ExportCsv" asp-route-id="@Model.ExamId" class="btn-gold-sk">
                <i class="fa-solid fa-file-csv me-1"></i> Export Scorecard CSV
            </a>
            <a asp-action="Index" class="btn-outline-sk">
                <i class="fa-solid fa-arrow-left me-1"></i> Back to Exams
            </a>
        </div>
    </div>

    <!-- Overview Stats Cards -->
    <div class="row g-3 mb-4">
        <div class="col-md-2 col-6">
            <div class="admin-stat-card" style="border-left-color:var(--navy)">
                <strong>@Model.TotalRegistered</strong>
                <span>Registered</span>
            </div>
        </div>
        <div class="col-md-2 col-6">
            <div class="admin-stat-card" style="border-left-color:var(--teal)">
                <strong>@Model.CompletedAttempts</strong>
                <span>Completed</span>
            </div>
        </div>
        <div class="col-md-2 col-6">
            <div class="admin-stat-card" style="border-left-color:var(--green)">
                <strong>@Model.AverageScore.ToString("F1")</strong>
                <span>Average Score</span>
            </div>
        </div>
        <div class="col-md-2 col-6">
            <div class="admin-stat-card" style="border-left-color:var(--gold)">
                <strong>@Model.HighestScore.ToString("F1")</strong>
                <span>Highest Score</span>
            </div>
        </div>
        <div class="col-md-2 col-6">
            <div class="admin-stat-card" style="border-left-color:var(--green)">
                <strong>@Model.PassPercentage.ToString("F0")%</strong>
                <span>Pass Rate</span>
            </div>
        </div>
        <div class="col-md-2 col-6">
            <div class="admin-stat-card" style="border-left-color:var(--purple)">
                <strong>@avgTime.Minutes Mins</strong>
                <span>Avg Duration</span>
            </div>
        </div>
    </div>

    <!-- Topic Breakdown -->
    @if (Model.TopicAnalytics != null && Model.TopicAnalytics.Any())
    {
        <div class="glass-card p-4 mb-4">
            <h5 class="fw-bold mb-3" style="color:var(--navy-dark)">
                <i class="fa-solid fa-chart-pie me-2 text-primary"></i>Topic-wise Accuracy Breakdown
            </h5>
            <div class="row g-3">
                @foreach (var topic in Model.TopicAnalytics)
                {
                    <div class="col-md-6">
                        <div class="p-3 border rounded-3 bg-light">
                            <div class="d-flex justify-content-between align-items-center mb-2">
                                <span class="fw-bold text-dark">@topic.Topic</span>
                                <span class="badge-soft dark">@topic.Correct / @topic.Total Correct (@topic.AccuracyPercentage.ToString("F0")%)</span>
                            </div>
                            <div class="progress" style="height: 10px; border-radius:6px">
                                <div class="progress-bar @(topic.AccuracyPercentage >= 75 ? "bg-success" : topic.AccuracyPercentage >= 50 ? "bg-warning text-dark" : "bg-danger")" 
                                     role="progressbar" 
                                     style="width: @(topic.AccuracyPercentage)%" 
                                     aria-valuenow="@topic.AccuracyPercentage" aria-valuemin="0" aria-valuemax="100"></div>
                            </div>
                        </div>
                    </div>
                }
            </div>
        </div>
    }

    <!-- Question Accuracy Breakdown -->
    @if (Model.QuestionAnalytics != null && Model.QuestionAnalytics.Any())
    {
        <div class="glass-card p-0 overflow-hidden">
            <div class="p-3 bg-white border-bottom fw-bold" style="color:var(--navy-dark)">
                <i class="fa-solid fa-list-check me-2 text-primary"></i>Question Accuracy Breakdown
            </div>
            <div class="table-responsive">
                <table class="table admin-table align-middle mb-0">
                    <thead>
                        <tr>
                            <th class="ps-4">Q#</th>
                            <th>Question Text</th>
                            <th>Topic</th>
                            <th>Difficulty</th>
                            <th>Attempts</th>
                            <th>Correct %</th>
                            <th class="pe-4">Accuracy Bar</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var q in Model.QuestionAnalytics)
                        {
                            <tr>
                                <td class="ps-4 fw-bold text-dark">Q@q.QuestionNumber</td>
                                <td class="text-dark small" style="max-width: 320px;">@q.QuestionText</td>
                                <td><span class="badge-soft dark" style="font-size:0.75rem">@q.Topic</span></td>
                                <td>
                                    <span class="badge @(q.Difficulty == "Hard" ? "bg-danger" : q.Difficulty == "Easy" ? "bg-success" : "bg-warning text-dark")" style="font-size:0.75rem">
                                        @q.Difficulty
                                    </span>
                                </td>
                                <td class="fw-semibold">@q.TotalAttempts</td>
                                <td class="fw-bold text-success">@q.CorrectPercentage.ToString("F0")%</td>
                                <td class="pe-4" style="width: 180px;">
                                    <div class="progress" style="height: 8px; border-radius:4px">
                                        <div class="progress-bar @(q.CorrectPercentage >= 70 ? "bg-success" : q.CorrectPercentage >= 40 ? "bg-warning text-dark" : "bg-danger")" 
                                             role="progressbar" 
                                             style="width: @(q.CorrectPercentage)%"></div>
                                    </div>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    }
</div>

