@model Shivakala.Core.Entities.Question
@{
    Layout = "_AdminLayout";
    ViewData["Title"] = "Add Single Question";
}

<div class="p-4">
    <div class="d-flex flex-wrap justify-content-between align-items-center mb-4 gap-3">
        <div>
            <span class="badge-soft dark mb-1"><i class="fa-solid fa-plus-circle me-1"></i>Question Editor</span>
            <h2 class="fw-bold mb-1" style="color:var(--navy-dark)">Add Single Question</h2>
            <p class="text-muted mb-0 small">Create a multiple-choice question with options and explanation for the question bank</p>
        </div>
        <a asp-action="QuestionBank" class="btn-outline-sk">
            <i class="fa-solid fa-arrow-left me-1"></i> Question Bank
        </a>
    </div>

    <div class="row justify-content-center">
        <div class="col-lg-10">
            <div class="glass-card p-4 p-md-5">
                @if (!ViewData.ModelState.IsValid)
                {
                    <div class="alert alert-danger py-2 mb-4">
                        @Html.ValidationSummary(false, "", new { @class = "mb-0" })
                    </div>
                }

                <form asp-action="CreateQuestion" method="post">
                    @Html.AntiForgeryToken()

                    <div class="row g-3 mb-3">
                        <div class="col-md-4">
                            <label class="form-label fw-semibold">Subject <span class="text-danger">*</span></label>
                            <input asp-for="Subject" class="form-control" placeholder="e.g. Science / Mathematics" required />
                        </div>
                        <div class="col-md-4">
                            <label class="form-label fw-semibold">Standard / Class <span class="text-danger">*</span></label>
                            <input asp-for="Standard" class="form-control" placeholder="e.g. 10th Standard" required />
                        </div>
                        <div class="col-md-4">
                            <label class="form-label fw-semibold">Topic / Chapter</label>
                            <input asp-for="Topic" class="form-control" placeholder="e.g. Chemical Reactions" />
                        </div>
                    </div>

                    <div class="row g-3 mb-4">
                        <div class="col-md-4">
                            <label class="form-label fw-semibold">Difficulty Level</label>
                            <select asp-for="Difficulty" class="form-select">
                                <option value="Easy">Easy</option>
                                <option value="Medium" selected>Medium</option>
                                <option value="Hard">Hard</option>
                            </select>
                        </div>
                        <div class="col-md-4">
                            <label class="form-label fw-semibold">Marks</label>
                            <input asp-for="Marks" class="form-control" type="number" min="1" max="20" required />
                        </div>
                        <div class="col-md-4">
                            <label class="form-label fw-semibold">Negative Marks</label>
                            <input asp-for="NegativeMarks" class="form-control" type="number" step="0.25" min="0" max="5" />
                        </div>
                    </div>

                    <div class="mb-4">
                        <label class="form-label fw-semibold">Question Text <span class="text-danger">*</span></label>
                        <textarea asp-for="QuestionText" class="form-control" rows="3" placeholder="Enter the complete question text here..." required></textarea>
                    </div>

                    <div class="mb-4">
                        <label class="form-label fw-semibold mb-3">Multiple Choice Options (Select Radio for Correct Answer) <span class="text-danger">*</span></label>
                        @{
                            var optionsList = Model.Options.ToList();
                        }
                        <div class="row g-3">
                            @for (int i = 0; i < optionsList.Count; i++)
                            {
                                var key = optionsList[i].OptionKey;
                                <div class="col-md-6">
                                    <div class="input-group">
                                        <div class="input-group-text bg-light">
                                            <input class="form-check-input mt-0 me-2" type="radio" name="correctOptionKey" value="@key" @(i == 0 ? "checked" : "") required />
                                            <strong>Option @key</strong>
                                        </div>
                                        <input type="hidden" name="Options[@i].OptionKey" value="@key" />
                                        <input type="text" name="Options[@i].OptionText" value="@optionsList[i].OptionText" class="form-control" placeholder="Option @key content..." required />
                                    </div>
                                </div>
                            }
                        </div>
                    </div>

                    <div class="mb-4">
                        <label class="form-label fw-semibold">Explanation / Solution Hint</label>
                        <textarea asp-for="Explanation" class="form-control" rows="2" placeholder="Optional detailed explanation or step-by-step solution for students..."></textarea>
                    </div>

                    <div class="d-flex justify-content-end gap-2 pt-3 border-top">
                        <a asp-action="QuestionBank" class="btn-outline-sk">Cancel</a>
                        <button type="submit" class="btn-primary-sk">
                            <i class="fa-solid fa-floppy-disk me-1"></i> Save Question
                        </button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

