@{
    Layout = "_AdminLayout";
    ViewData["Title"] = "Import Questions from Document";
    var examId = ViewBag.ExamId as int?;
}

<div class="p-4">
    <div class="d-flex flex-wrap justify-content-between align-items-center mb-4 gap-3">
        <div>
            <span class="badge-soft dark mb-1"><i class="fa-solid fa-file-import me-1"></i>AI Document Parser</span>
            <h2 class="fw-bold mb-1" style="color:var(--navy-dark)">Import Questions from Document</h2>
            <p class="text-muted mb-0 small">Automatically extract questions and options from PDF, PPT, PPTX or Image files</p>
        </div>
        <a asp-action="Index" class="btn-outline-sk">
            <i class="fa-solid fa-arrow-left me-1"></i> Back
        </a>
    </div>

    <div class="row justify-content-center">
        <div class="col-lg-8">
            <div class="glass-card p-4 p-md-5">
                <form asp-action="ImportPreview" method="post" enctype="multipart/form-data">
                    @Html.AntiForgeryToken()
                    <input type="hidden" name="examId" value="@examId" />

                    <div class="p-3 bg-light rounded-3 border mb-4">
                        <h6 class="fw-bold mb-2" style="color:var(--navy-dark)"><i class="fa-solid fa-circle-info text-primary me-1"></i> Supported Document Formats:</h6>
                        <ul class="mb-0 small text-muted ps-3" style="line-height:1.7">
                            <li><strong>PDF Documents (.pdf)</strong> - Extracts text pages and question structures</li>
                            <li><strong>PowerPoint Presentations (.ppt, .pptx)</strong> - Parses slides into questions</li>
                            <li><strong>Images (.jpg, .jpeg, .png)</strong> - OCR and vision layout parsing</li>
                            <li><strong>Text Files (.txt)</strong> - Fast structured text parser</li>
                        </ul>
                    </div>

                    <div class="row g-3 mb-4">
                        <div class="col-md-6">
                            <label class="form-label fw-semibold">Default Subject</label>
                            <input type="text" name="defaultSubject" class="form-control" value="General" placeholder="e.g. Science" required />
                        </div>
                        <div class="col-md-6">
                            <label class="form-label fw-semibold">Default Standard</label>
                            <input type="text" name="defaultStandard" class="form-control" value="General" placeholder="e.g. 10th Standard" required />
                        </div>
                    </div>

                    <div class="mb-4">
                        <label class="form-label fw-semibold">Select Document File <span class="text-danger">*</span></label>
                        <input type="file" name="file" class="form-control form-control-lg" accept=".pdf,.ppt,.pptx,.jpg,.jpeg,.png,.txt" required />
                        <small class="text-muted">Maximum file size: 25MB.</small>
                    </div>

                    <div class="pt-2">
                        <button type="submit" class="btn-primary-sk w-100 py-3 justify-content-center text-uppercase">
                            <i class="fa-solid fa-wand-magic-sparkles me-2"></i> Upload &amp; Preview Extracted Questions
                        </button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

