@if (TempData["SuccessMessage"] is string success && !string.IsNullOrWhiteSpace(success))
{
    <div class="container pt-3">
        <div class="glass-alert d-flex align-items-center gap-2">
            <i class="fa-solid fa-circle-check fa-lg"></i>
            <span>@success</span>
            <button type="button" class="btn-close ms-auto" data-bs-dismiss="alert" aria-label="Close" style="font-size:0.75rem"></button>
        </div>
    </div>
}
@if (TempData["ErrorMessage"] is string error && !string.IsNullOrWhiteSpace(error))
{
    <div class="container pt-3">
        <div class="glass-alert d-flex align-items-center gap-2" style="background:rgba(192,57,43,0.1);border-color:rgba(192,57,43,0.3);color:var(--red)">
            <i class="fa-solid fa-circle-exclamation fa-lg"></i>
            <span>@error</span>
            <button type="button" class="btn-close ms-auto" data-bs-dismiss="alert" aria-label="Close" style="font-size:0.75rem"></button>
        </div>
    </div>
}
