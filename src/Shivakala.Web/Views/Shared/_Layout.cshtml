@using System.Globalization
@{
    var title = ViewData["Title"]?.ToString() ?? "Shivakala Coaching Classes";
    var description = ViewData["MetaDescription"]?.ToString() ?? "Shivakala Coaching Classes — KG1 to 10th Standard. Strong Foundation Today, Brilliant Success Tomorrow!";
    var currentCulture = CultureInfo.CurrentUICulture.TwoLetterISOLanguageName;
    var isMr = currentCulture == "mr";
    var returnUrl = Context.Request.Path + Context.Request.QueryString;
}
<!DOCTYPE html>
<html lang="@currentCulture" data-theme="light">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>@title</title>
    <meta name="description" content="@description" />
    <meta name="keywords" content="Shivakala Coaching Classes, SK Classes, KG1 to 10th, SSC coaching, Chikhali, Maharashtra" />
    <meta property="og:title" content="@title" />
    <meta property="og:description" content="@description" />
    <meta name="theme-color" content="#1B2B6B" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Marcellus&family=Noto+Sans+Devanagari:wght@400;500;600;700&family=Outfit:wght@300;400;500;600;700&display=swap" rel="stylesheet" />
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet" crossorigin="anonymous" />
    <link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.2/css/all.min.css" rel="stylesheet" crossorigin="anonymous" referrerpolicy="no-referrer" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body>

    <!-- TOP STRIP -->
    <div class="top-strip">
        <div class="container d-flex flex-wrap justify-content-between align-items-center gap-2">
            <span><i class="fa-solid fa-phone-volume me-2"></i>+91 80878 07011 &nbsp;|&nbsp; +91 88309 07011</span>
            <span><i class="fa-solid fa-location-dot me-2"></i>@(isMr ? "चिखली, महाराष्ट्र" : "Chikhali, Maharashtra")</span>
        </div>
    </div>

    <!-- NAVBAR -->
    <header class="sk-navbar">
        <nav class="navbar navbar-expand-lg py-0">
            <div class="container">
                <!-- BRAND LOGO -->
                <a class="navbar-brand" asp-controller="Home" asp-action="Index">
                    <!-- SVG Logo matching SK Learning For Life brand -->
                    <svg class="brand-logo-svg" viewBox="0 0 120 120" xmlns="http://www.w3.org/2000/svg">
                        <!-- Open book base -->
                        <path d="M12 72 Q60 62 108 72 L108 95 Q60 85 12 95 Z" fill="#1B7A3E" opacity="0.9"/>
                        <path d="M12 72 Q60 62 60 62 L60 95 Q60 85 12 95 Z" fill="#145C2F"/>
                        <path d="M108 72 Q60 62 60 62 L60 95 Q60 85 108 95 Z" fill="#1B7A3E"/>
                        <!-- Book spine line -->
                        <line x1="60" y1="62" x2="60" y2="95" stroke="#0D4A24" stroke-width="2"/>
                        <!-- Book left cover -->
                        <path d="M14 40 Q13 68 12 72 Q60 62 60 62 L60 30 Q38 30 14 40 Z" fill="#1B7A3E" opacity="0.15"/>
                        <path d="M14 40 Q13 68 12 72 Q60 62 60 62 L60 30 Q38 30 14 40 Z" fill="none" stroke="#1B7A3E" stroke-width="2.5"/>
                        <!-- Book right cover -->
                        <path d="M106 40 Q107 68 108 72 Q60 62 60 62 L60 30 Q82 30 106 40 Z" fill="#1B7A3E" opacity="0.15"/>
                        <path d="M106 40 Q107 68 108 72 Q60 62 60 62 L60 30 Q82 30 106 40 Z" fill="none" stroke="#1B7A3E" stroke-width="2.5"/>
                        <!-- Letter S -->
                        <text x="26" y="65" font-family="'Marcellus',serif" font-size="32" font-weight="700" fill="#1B2B6B">S</text>
                        <!-- Letter K with arrow -->
                        <text x="60" y="65" font-family="'Marcellus',serif" font-size="32" font-weight="700" fill="#1B2B6B">K</text>
                        <!-- Upward arrow on K -->
                        <line x1="88" y1="55" x2="98" y2="38" stroke="#1B7A3E" stroke-width="3" stroke-linecap="round"/>
                        <polyline points="92,38 98,38 98,44" fill="none" stroke="#1B7A3E" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"/>
                        <!-- Graduation cap -->
                        <polygon points="60,8 84,18 60,28 36,18" fill="#F5A623"/>
                        <rect x="78" y="18" width="3" height="14" fill="#F5A623" rx="1"/>
                        <circle cx="79.5" cy="33" r="4" fill="#F5A623"/>
                        <rect x="57" y="25" width="6" height="10" fill="#E09000" rx="1"/>
                    </svg>
                    <div class="brand-text-block">
                        <span class="brand-name">SHIVKALA</span>
                        <span class="brand-rule">CLASSES</span>
                        <span style="font-size:0.62rem;color:var(--text-mid);letter-spacing:1.5px;">SK LEARNING FOR LIFE</span>
                    </div>
                </a>

                <button class="navbar-toggler border-0 ms-auto" type="button" data-bs-toggle="collapse" data-bs-target="#mainNav" aria-label="Toggle navigation">
                    <span class="navbar-toggler-icon"></span>
                </button>

                <div class="collapse navbar-collapse" id="mainNav">
                    <ul class="navbar-nav mx-auto align-items-lg-center gap-lg-1">
                        <li class="nav-item"><a class="nav-link" asp-controller="Home" asp-action="Index">@T["NavHome"]</a></li>
                        <li class="nav-item"><a class="nav-link" asp-controller="About" asp-action="Index">@T["NavAbout"]</a></li>
                        <li class="nav-item"><a class="nav-link" asp-controller="Courses" asp-action="Index">@T["NavCourses"]</a></li>
                        <li class="nav-item"><a class="nav-link" asp-controller="Home" asp-action="Index" fragment="weekly-test">@(isMr ? "साप्ताहिक चाचणी" : "Weekly Test")</a></li>
                        <li class="nav-item"><a class="nav-link" asp-controller="Registration" asp-action="Index">@T["NavRegistration"]</a></li>
                        <li class="nav-item"><a class="nav-link" asp-controller="Enquiry" asp-action="Index">@T["NavEnquiry"]</a></li>
                        <li class="nav-item"><a class="nav-link" asp-controller="Contact" asp-action="Index">@T["NavContact"]</a></li>
                    </ul>
                    <div class="d-flex align-items-center gap-2 ms-lg-2">
                        <!-- Language switcher -->
                        <form asp-controller="Home" asp-action="SetLanguage" method="post" class="d-inline">
                            @Html.AntiForgeryToken()
                            <input type="hidden" name="culture" value="@(isMr ? "en" : "mr")" />
                            <input type="hidden" name="returnUrl" value="@returnUrl" />
                            <button type="submit" class="btn-lang">@T["LanguageSwitcher"]</button>
                        </form>
                        <!-- Dark mode -->
                        <button type="button" id="themeToggle" aria-label="Toggle theme">
                            <i class="fa-solid fa-moon"></i>
                        </button>
                        <!-- Admin / Login -->
                        <a class="btn-login nav-link" asp-controller="Admin" asp-action="Login">
                            <i class="fa-solid fa-user me-1"></i>@(isMr ? "लॉगिन / नोंदणी" : "Login / Register")
                        </a>
                    </div>
                </div>
            </div>
        </nav>
    </header>

    <main>
        @await Html.PartialAsync("Partials/_FlashMessage")
        @RenderBody()
    </main>

    <!-- FOOTER -->
    <footer class="site-footer">
        <div class="container">
            <div class="row g-4">
                <div class="col-lg-4">
                    <div class="d-flex align-items-center gap-3 mb-3">
                        <svg width="48" height="48" viewBox="0 0 120 120" xmlns="http://www.w3.org/2000/svg">
                            <path d="M12 72 Q60 62 108 72 L108 95 Q60 85 12 95 Z" fill="#1B7A3E" opacity="0.9"/>
                            <path d="M14 40 Q13 68 12 72 Q60 62 60 62 L60 30 Q38 30 14 40 Z" fill="none" stroke="#1B7A3E" stroke-width="2.5"/>
                            <path d="M106 40 Q107 68 108 72 Q60 62 60 62 L60 30 Q82 30 106 40 Z" fill="none" stroke="#1B7A3E" stroke-width="2.5"/>
                            <text x="26" y="65" font-family="serif" font-size="32" font-weight="700" fill="#fff">S</text>
                            <text x="60" y="65" font-family="serif" font-size="32" font-weight="700" fill="#fff">K</text>
                            <polygon points="60,8 84,18 60,28 36,18" fill="#F5A623"/>
                            <rect x="57" y="25" width="6" height="10" fill="#E09000" rx="1"/>
                        </svg>
                        <div>
                            <div style="color:#fff;font-family:'Marcellus',serif;font-size:1.1rem;font-weight:700;">SHIVKALA CLASSES</div>
                            <div style="color:var(--gold-light);font-size:0.7rem;letter-spacing:2px;">SK LEARNING FOR LIFE</div>
                        </div>
                    </div>
                    <p>@T["FooterSummary"]</p>
                </div>
                <div class="col-lg-4 col-md-6">
                    <h6>@T["QuickLinks"]</h6>
                    <ul class="footer-links">
                        <li><a asp-controller="Home" asp-action="Index">@T["NavHome"]</a></li>
                        <li><a asp-controller="About" asp-action="Index">@T["NavAbout"]</a></li>
                        <li><a asp-controller="Courses" asp-action="Index">@T["NavCourses"]</a></li>
                        <li><a asp-controller="Registration" asp-action="Index">@T["AdmissionNow"]</a></li>
                        <li><a asp-controller="Enquiry" asp-action="Index">@T["NavEnquiry"]</a></li>
                        <li><a asp-controller="Contact" asp-action="Index">@T["NavContact"]</a></li>
                    </ul>
                </div>
                <div class="col-lg-4 col-md-6">
                    <h6>@T["ContactUs"]</h6>
                    <p class="mb-2"><i class="fa-solid fa-location-dot me-2" style="color:var(--gold-light)"></i>@(isMr ? "शिवकला क्लासेस, चिखली, महाराष्ट्र" : "Shivakala Classes, Chikhali, Maharashtra")</p>
                    <p class="mb-2"><i class="fa-solid fa-phone me-2" style="color:var(--gold-light)"></i>+91 80878 07011</p>
                    <p class="mb-2"><i class="fa-solid fa-phone me-2" style="color:var(--gold-light)"></i>+91 88309 07011</p>
                    <p class="mb-2"><i class="fa-solid fa-envelope me-2" style="color:var(--gold-light)"></i>info@shivkalaclasses.com</p>
                    <p class="mb-0"><i class="fa-solid fa-globe me-2" style="color:var(--gold-light)"></i>www.shivkalaclasses.com</p>
                </div>
            </div>
        </div>
        <!-- Contact Strip -->
        <div class="footer-contact-strip mt-4">
            <div class="container">
                <div class="contact-items">
                    <div class="footer-contact-item">
                        <i class="fa-solid fa-location-dot"></i>
                        <div><strong>@(isMr ? "पत्ता" : "ADDRESS")</strong>@(isMr ? "शिवकला क्लासेस, चिखली" : "Shivakala Classes, Chikhali")</div>
                    </div>
                    <div class="footer-contact-item">
                        <i class="fa-solid fa-phone"></i>
                        <div><strong>@(isMr ? "फोन" : "PHONE")</strong>+91 80878 07011</div>
                    </div>
                    <div class="footer-contact-item">
                        <i class="fa-solid fa-envelope"></i>
                        <div><strong>EMAIL</strong>info@shivkalaclasses.com</div>
                    </div>
                    <div class="footer-contact-item">
                        <i class="fa-solid fa-globe"></i>
                        <div><strong>WEBSITE</strong>www.shivkalaclasses.com</div>
                    </div>
                </div>
            </div>
        </div>
        <div class="footer-bottom">
            <p>&copy; @DateTime.UtcNow.Year Shivakala Coaching Classes, Chikhali &nbsp;|&nbsp; @T["FooterRights"] &nbsp;|&nbsp; SK Learning For Life</p>
        </div>
    </footer>

    <!-- WhatsApp Float -->
    <a class="whatsapp-float" href="https://wa.me/918087807011?text=Hello%20Shivakala%20Coaching%20Classes" target="_blank" rel="noopener noreferrer" aria-label="WhatsApp">
        <i class="fa-brands fa-whatsapp"></i>
    </a>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js" crossorigin="anonymous"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
