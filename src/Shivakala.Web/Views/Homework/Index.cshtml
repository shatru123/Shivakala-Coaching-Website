@model IReadOnlyList<Shivakala.Core.Entities.Homework>
@{ ViewData["Title"] = "Homework | Admin"; }

<section class="page-hero" style="background:linear-gradient(135deg,var(--navy-dark),var(--navy-mid))">
    <div class="container d-flex justify-content-between align-items-center flex-wrap gap-3">
        <div><span class="badge-soft"><i class="fa-solid fa-book-open me-1"></i>Admin</span><h1>Homework & Assignments</h1></div>
        <a asp-action="Create" class="btn-primary-sk"><i class="fa-solid fa-plus"></i>Assign Homework</a>
    </div>
</section>

<section class="section-shell pt-0">
    <div class="container">
        @if (TempData["SuccessMessage"] is string m){ <div class="alert alert-success">@m</div> }
        <div class="row g-3">
            @foreach (var h in Model)
            {
                var overdue = DateOnly.FromDateTime(h.DueDate) < UtcDateTime.Today();
                <div class="col-md-4">
                    <div class="glass-card h-100 @(overdue?"border-danger":"")" style="@(overdue?"border:1px solid var(--red)":"")">
                        <div class="d-flex justify-content-between align-items-start mb-2">
                            <span class="badge-soft dark" style="font-size:.7rem">@h.Subject · @h.Standard</span>
                            @if (overdue)
                            { <span class="badge bg-danger" style="font-size:.68rem">Overdue</span> }
                        </div>
                        <h6 style="font-weight:700">@h.Title</h6>
                        <p class="text-muted small mb-2">@(h.Description ?? "No description")</p>
                        <div class="d-flex gap-2 mt-2 text-muted small">
                            <span><i class="fa-solid fa-chalkboard-teacher me-1"></i>@(h.AssignedByTeacher?.FullName ?? "—")</span>
                            <span><i class="fa-solid fa-calendar me-1"></i>Due: @h.DueDate.ToString("dd MMM")</span>
                        </div>
                        @if (!string.IsNullOrEmpty(h.AttachmentUrl))
                        {
                            <a href="@h.AttachmentUrl" target="_blank" class="btn-outline-sk mt-2 d-inline-block" style="font-size:.72rem;padding:4px 10px">
                                <i class="fa-solid fa-paperclip"></i> Attachment
                            </a>
                        }
                        <div class="d-flex gap-1 mt-3">
                            <a asp-action="Submissions" asp-route-id="@h.Id" class="toolbar-btn" style="font-size:.7rem;padding:4px 8px">
                                <i class="fa-solid fa-inbox"></i> Submissions
                            </a>
                            <form asp-action="Delete" asp-route-id="@h.Id" method="post" onsubmit="return confirm('Delete?')">
                                @Html.AntiForgeryToken()
                                <button class="toolbar-btn" style="font-size:.7rem;padding:4px 8px;background:var(--red)">
                                    <i class="fa-solid fa-trash"></i>
                                </button>
                            </form>
                        </div>
                    </div>
                </div>
            }
        </div>
    </div>
</section>
